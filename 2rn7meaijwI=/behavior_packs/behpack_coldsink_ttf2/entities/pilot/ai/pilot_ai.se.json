{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:pilot_ai",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        // 0-闲置、1-一跳、2-二跳、3-左滑墙、4-右滑墙、5-滑铲
        "titan:action": {
          "type": "int",
          "range": [ 0, 10 ],
          "default": 0,
          "client_sync": true
        },
        // 0-闲置、1-开火/蓄力、2-蓄力开火、3-近战
        "titan:other_action": {
          "type": "int",
          "range": [ 0, 10 ],
          "default": 0,
          "client_sync": true
        },
        "titan:team": {
          "type": "int",
          "range": [ 1, 2 ],
          "default": 1,
          "client_sync": true
        },
        // 手持武器类别
        // 0-无、1-R201、2电笔
        "pilot:weapon": {
          "type": "int",
          "range": [ 0, 30 ],
          "default": 0,
          "client_sync": true
        },
        // 训牛状态
        "pilot:rodeo_status": {
          "type": "int",
          // 1训牛敌方拔电池 2训牛敌方扔手雷 3训牛我方插电池 4训牛我方搭便车
          "range": [ 0, 4 ],
          "default": 0,
          "client_sync": true
        },
        // 拥有电池类型
        "pilot:has_battery": {
          "type": "int",
          // 1普通电池 2强力电池 3过载电池
          "range": [ 0, 3 ],
          "default": 0,
          "client_sync": true
        }
      },
      "animations": {
        "c.pilot_ai_other_action": "controller.animation.pilot_ai_other_action.func",
        "c.pilot_ai_death": "controller.animation.pilot_ai_death.func",
        "pilot_ai_timer_core": "animation.pilot_ai_timer_core.func",
        "c.pilot_ai_melee": "controller.animation.pilot_ai_melee.func",
        "pilot_ai_melee": "animation.pilot_ai_melee.func",
        "c.pilot_ai_action": "controller.animation.pilot_ai_action.func",
        "pilot_ai_two_jump": "animation.pilot_ai_two_jump.func",
        "pilot_ai_check_slip_wall": "animation.pilot_ai_check_slip_wall.func",
        "pilot_ai_slip_wall": "animation.pilot_ai_slip_wall.func",
        "pilot_ai_slide_trigger": "animation.pilot_ai_slide_trigger.func",
        "pilot_ai_slide_over": "animation.pilot_ai_slide_over.func",
        "pilot_ai_rodeo_trigger": "animation.pilot_ai_rodeo_trigger.func",
        "c.pilot_ai_has_battery": "controller.animation.pilot_ai_has_battery.func",
        "c.pilot_rodeo_titan": "controller.animation.pilot_rodeo_titan.func",
        "rodeo_enemy_battery": "animation.rodeo_enemy_battery",
        "rodeo_enemy_grenade": "animation.rodeo_enemy_grenade",
        "rodeo_friend_battery": "animation.rodeo_friend_battery",
        "rodeo_friend_idle": "animation.rodeo_friend_idle",
        "pilot_ai_rodeo_idle_leave": "animation.pilot_ai_rodeo_idle_leave.func"
      },
      "scripts": {
        "animate": [ 
          {
            "c.pilot_ai_action": "q.property('pilot:rodeo_status') == 0"
          },
          {
            "c.pilot_ai_other_action": "q.property('pilot:rodeo_status') == 0 || q.property('pilot:rodeo_status') == 4"
          },
          {
            "c.pilot_ai_melee": "q.property('pilot:rodeo_status') == 0"
          },
          "c.pilot_ai_death",
          "c.pilot_ai_has_battery",
          "c.pilot_rodeo_titan"
        ]
      }
    },

    "components": {
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "height": 1.9,
        "width": 0.6
      },
      "minecraft:knockback_resistance": {
        "value": 0.3
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          // 防友伤
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_tag",
                    "subject": "self",
                    "value": "team_blue"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "team_blue"
                  }
                ]
              }
            },
            "cause": "all",
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_tag",
                    "subject": "self",
                    "value": "team_red"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "team_red"
                  }
                ]
              }
            },
            "cause": "all",
            "deals_damage": false
          },
          // 免疫铁驭的反泰坦武器直击伤害
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "pilot"
                  }
                ]
              }
            },
            "cause": "projectile",
            "deals_damage": false
          }
        ]
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [ "ai_rider_tool" ],
        "seats": [
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          }
        ]
      },
      "minecraft:timer": {
        "time": [ 5.0, 8.0 ],
        "time_down_event": {
          "event": "pilot_jump_one",
          "target": "self"
        }
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:out_of_control": {},
      // 追击靠近距离
      "minecraft:target_nearby_sensor": {
        "inside_range": 64,
        "on_inside_range": {
          "event": "turn_pilot_state_normal",
          "target": "self"
        },
        "outside_range": 64,
        "on_outside_range": {
          "event": "turn_pilot_state_melee",
          "target": "self"
        }
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.nearest_prioritized_attackable_target": {
        "priority": 1,
        "within_radius": 16,
        "reselect_targets": true,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "entity_types": [
          // 玩家与泰坦
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_staic"
                }
              ]
            },
            "max_dist": 512,
            "priority": 1
          },
          // 怪物
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 512,
            "priority": 2
          }
        ]
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },

      // 玩家无敌
      "coldsink:player_hurt_no": {
        "minecraft:type_family": {
          "family": [ "player", "pilot", "pilot_ai", "ai", "tool" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": false
            }
          ]
        }
      },
      "coldsink:player_hurt_yes": {
        "minecraft:type_family": {
          "family": [ "player", "pilot", "pilot_ai", "ai" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "fall",
              "deals_damage": false
            },
            // 防友伤
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_blue"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_blue"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_red"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_red"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            },
            // 免疫铁驭的反泰坦武器直击伤害
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "pilot"
                    }
                  ]
                }
              },
              "cause": "projectile",
              "deals_damage": false
            }
          ]
        }
      },
      
      // 0-常规模式
      "pilot_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:shooter": {
          "def": "arrow"
        }
      },

      // 1-近战模式（靠近目标）
      "pilot_state_melee":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:follow_range": {
          "value": 512,
          "max": 512
        },
        "minecraft:attack": {
          "damage": 0
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 1,
          "attack_duration": 0.5,
          "hit_delay_pct": 1,
          "reach_multiplier": 1,
          "require_complete_path": false,
          "track_target": true,
          "y_max_head_rotation": 30
        },
        "minecraft:ageable": {
          "duration": 1.2,
          "grow_up": {
            "event": "turn_pilot_state_spurt",
            "target": "self"
          }
        }
      },

      // 2-闪避模式
      "pilot_state_spurt":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:movement": {
          "value": 0.7
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 0,
          "max_dist": 16,
          "max_flee": 16,
          "remove_target": false,
          "entity_types": [
            // 玩家、泰坦、电烟
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "any_of": [
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "player"
                      },
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "titan_elect_smoke"
                      }
                    ]
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            }
          ]
        },
        "minecraft:ageable": {
          "duration": 1.2,
          "grow_up": {
            "event": "turn_pilot_state_normal",
            "target": "self"
          }
        }
      }

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "pilot_state_normal"
          ]
        },
        "queue_command": {
          "command": [
            "function pilot/init",
            "effect @s jump_boost 99999 1 true",
            "effect @s resistance 99999 2 true",
            "effect @s regeneration 99999 1 true",
            "scoreboard objectives add random_score dummy random_score",
            "scoreboard objectives add slip_bool dummy slip_bool",
            "scoreboard objectives add action_random dummy action_random",
            "scoreboard objectives add pilot_weapon dummy pilot_weapon",
            "ride @s summon_rider coldsink:pilot_rider_ai",
            "tag @s add is_pilot",
            "tag @s add team_blue",
            "tag @s add ronin_defend_core",
            "tp @s[tag=to_high] ~~64~",
            "event entity @s[tag=team_red] team_red",
            // 复活继承泰坦值
            "scoreboard players operation @s[tag=!team_red] pilot_core = pilot_core_blue map"
          ]
        }
      },
      // 队伍
      "team_blue":{
        "set_property":{
          "titan:team": 1
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "tag @s remove team_red",
            "event entity @e[type=coldsink:pilot_rider_ai,r=8,c=1] team_blue"
          ]
        }
      },
      "team_red":{
        "set_property":{
          "titan:team": 2
        },
        "queue_command": {
          "command": [
            "tag @s add team_red",
            "tag @s remove team_blue",
            "event entity @e[type=coldsink:pilot_rider_ai,r=8,c=1] team_red",
            // 复活继承泰坦值
            "scoreboard players operation @s pilot_core = pilot_core_red map"
          ]
        }
      },
      // 切到常规模式
      "turn_pilot_state_normal":{
        "add": {
          "component_groups": [
            "pilot_state_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "pilot_state_melee",
            "pilot_state_spurt"
          ]
        }
      },
      // 切到近战模式
      "turn_pilot_state_melee":{
        "add": {
          "component_groups": [
            "pilot_state_melee"
          ]
        },
        "remove": {
          "component_groups": [
            "pilot_state_normal",
            "pilot_state_spurt"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=begin_melee] set_other_action_3",
            "tag @s remove begin_melee"
          ]
        }
      },
      // 切到闪避模式
      "turn_pilot_state_spurt":{
        "add": {
          "component_groups": [
            "pilot_state_spurt"
          ]
        },
        "remove": {
          "component_groups": [
            "pilot_state_normal",
            "pilot_state_melee"
          ]
        }
      },
      // 获取核心值计算
      "pilot_shoot_get_core": {
        "queue_command": {
          "command": [
            "scoreboard players operation @s pilot_attack_tem = @s pilot_attack",
            "scoreboard players operation @s pilot_attack_tem /= normal_divisor pilot_attack_tem",
            "scoreboard players operation @s pilot_core += @s pilot_attack_tem",
            "scoreboard players operation @s pilot_attack %= normal_divisor pilot_attack_tem"
          ]
        }
      },
      "call_titan_random": {
        "queue_command": {
          "command": [
            "spreadplayers ~ ~ 0 1 @s",
            "scoreboard players random @s random_score 1 7",
            "execute @s[scores={random_score=1},tag=team_blue] ~~~ summon coldsink:ion_titan_ai_summon_blue",
            "execute @s[scores={random_score=2},tag=team_blue] ~~~ summon coldsink:tone_titan_ai_summon_blue",
            "execute @s[scores={random_score=3},tag=team_blue] ~~~ summon coldsink:northstar_titan_ai_summon_blue",
            "execute @s[scores={random_score=4},tag=team_blue] ~~~ summon coldsink:ronin_titan_ai_summon_blue",
            "execute @s[scores={random_score=5},tag=team_blue] ~~~ summon coldsink:scorch_titan_ai_summon_blue",
            "execute @s[scores={random_score=6},tag=team_blue] ~~~ summon coldsink:legion_titan_ai_summon_blue",
            "execute @s[scores={random_score=7},tag=team_blue] ~~~ summon coldsink:monarch_titan_ai_summon_blue",
            "execute @s[scores={random_score=1},tag=team_red] ~~~ summon coldsink:ion_titan_ai_summon_red",
            "execute @s[scores={random_score=2},tag=team_red] ~~~ summon coldsink:tone_titan_ai_summon_red",
            "execute @s[scores={random_score=3},tag=team_red] ~~~ summon coldsink:northstar_titan_ai_summon_red",
            "execute @s[scores={random_score=4},tag=team_red] ~~~ summon coldsink:ronin_titan_ai_summon_red",
            "execute @s[scores={random_score=5},tag=team_red] ~~~ summon coldsink:scorch_titan_ai_summon_red",
            "execute @s[scores={random_score=6},tag=team_red] ~~~ summon coldsink:legion_titan_ai_summon_red",
            "execute @s[scores={random_score=7},tag=team_red] ~~~ summon coldsink:monarch_titan_ai_summon_red",
            "execute @s[tag=has_battery_good] ~~~ tag @e[family=summon_titan_ai,r=8] add get_battery",
            "event entity @s godie"
          ]
        }
      },
      // 击杀铁驭
      "kill_other_pilot": {
        "queue_command": {
          "command": [
						"scoreboard players add @s pilot_attack 100",
						"event entity @s pilot_shoot_get_core"
          ]
        }
      },
      // 击杀泰坦
      "kill_other_titan": {
        "queue_command": {
          "command": [
						"scoreboard players add @s pilot_attack 100",
						"event entity @s pilot_shoot_get_core"
          ]
        }
      },

      // 跳跃
      "pilot_jump_one": {
        "queue_command": {
          "command": [
            "tag @s[tag=!is_sliding] add one_jump_self",
            "execute @s[tag=!is_sliding] ~~~ summon coldsink:one_jump_tool_ai"
          ]
        }
      },

      // 训牛
      "check_rodeo_titan": {
        "queue_command": {
          "command": [
            "tag @s add rodeo_titan_self",
            "ride @s stop_riding",
            "event entity @s set_action_0",

            // 训牛友方
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ event entity @s[tag=team_blue,tag=!has_rodeo] rodeo_summon_ride",
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_blue,tag=!has_rodeo] ~~~ event entity @e[family=pilot,tag=rodeo_titan_self,c=1] rodeo_friend_titan",
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_blue,tag=!has_rodeo] ~~~ tag @e[family=pilot,tag=rodeo_titan_self,c=1] add rodeo_ride_self",
            
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ event entity @s[tag=team_red,tag=!has_rodeo] rodeo_summon_ride",
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_red,tag=!has_rodeo] ~~~ event entity @e[family=pilot,tag=rodeo_titan_self,c=1] rodeo_friend_titan",
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_red,tag=!has_rodeo] ~~~ tag @e[family=pilot,tag=rodeo_titan_self,c=1] add rodeo_ride_self",

            // 训牛敌方
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ event entity @s[tag=team_red,tag=!has_rodeo] rodeo_summon_ride",
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_red,tag=!has_rodeo] ~~~ event entity @e[family=pilot,tag=rodeo_titan_self,c=1] rodeo_enemy_titan",
            "execute @s[tag=team_blue] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_red,tag=!has_rodeo] ~~~ tag @e[family=pilot,tag=rodeo_titan_self,c=1] add rodeo_ride_self",
            
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ event entity @s[tag=team_blue,tag=!has_rodeo] rodeo_summon_ride",
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_blue,tag=!has_rodeo] ~~~ event entity @e[family=pilot,tag=rodeo_titan_self,c=1] rodeo_enemy_titan",
            "execute @s[tag=team_red] ~~-5~ execute @e[family=titan,tag=!titan_falling,r=8,c=1] ~~~ execute @s[tag=team_blue,tag=!has_rodeo] ~~~ tag @e[family=pilot,tag=rodeo_titan_self,c=1] add rodeo_ride_self",

            "tag @s remove rodeo_titan_self"
          ]
        }
      },
