{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:pilot_rider_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "ctrl.pilot_ai_rider_target": "controller.animation.pilot_ai_rider_target.func"
      },
      "scripts": {
        "animate": [
          "ctrl.pilot_ai_rider_target"
        ]
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool", "ai_rider_tool", "ai" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 1,
        "width": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      // 射击近战切换距离
      "minecraft:target_nearby_sensor": {
        "inside_range": 16,
        "on_inside_range": {
          "event": "random_normal_or_melee",
          "target": "self"
        },
        "outside_range": 16,
        "on_outside_range": {
          "event": "turn_rider_state_aim",
          "target": "self"
        }
      },
      "minecraft:follow_range": {
        "value": 512,
        "max": 512
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "all_of": [
                {
                  "test": "is_riding",
                  "subject": "self",
                  "operator": "!="
                }
              ]
            }
          ]
        }
      },
      // 索敌
      "minecraft:behavior.nearest_prioritized_attackable_target": {
        "priority": 1,
        "within_radius": 128,
        "reselect_targets": true,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "entity_types": [
          // 玩家与泰坦
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_staic"
                }
              ]
            },
            "max_dist": 512,
            "priority": 1
          },
          // 怪物
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 512,
            "priority": 2
          }
        ]
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },
      
      // 闲置模式
      "pilot_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:attack": {
          "damage": 1
        },
        "minecraft:behavior.melee_attack": {
          "track_target": true,
          "reach_multiplier": 0
        }
      },
      // 瞄准模式
      "pilot_state_aim":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:ageable": {
          "duration": 0.5,
          "grow_up": {
            "event": "turn_rider_state_fire",
            "target": "self"
          }
        }
      },
      // 武器模式-R201
      "pilot_state_fire_r201":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.1,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 武器模式-电笔
      "pilot_state_fire_charge":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 1.8,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 主武器
      "weapon_main": {
        "minecraft:timer": {
          "time": [ 5.0, 8.0 ],
          "time_down_event": {
            "event": "turn_rider_weapon_off",
            "target": "self"
          }
        }
      },
      // 副武器
      "weapon_off": {
        "minecraft:timer": {
          "time": [ 3.0, 5.0 ],
          "time_down_event": {
            "event": "turn_rider_weapon_main",
            "target": "self"
          }
        }
      },
      // R201子弹
      "bullet_r201_blue": {
        "minecraft:shooter": {
          "def": "coldsink:pilot_ai_bullet_blue<bullet_r201>"
        }
      },
      "bullet_r201_red": {
        "minecraft:shooter": {
          "def": "coldsink:pilot_ai_bullet_red<bullet_r201>"
        }
      },
      // 电笔子弹
      "bullet_charge_blue": {
        "minecraft:shooter": {
          "def": "coldsink:pilot_ai_bullet_blue<bullet_charge>"
        }
      },
      "bullet_charge_red": {
        "minecraft:shooter": {
          "def": "coldsink:pilot_ai_bullet_red<bullet_charge>"
        }
      }

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "pilot_state_normal",
            "weapon_main",
            "bullet_r201_blue"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "execute @e[family=pilot_ai,r=8,c=1] ~~~ execute @s[tag=team_red] ~~~ event entity @e[type=coldsink:pilot_rider_ai,r=8,c=1] team_red",
            "event entity @e[family=pilot_ai,r=8,c=1] set_weapon_1"
          ]
        }
      },
      // 队伍
      "team_blue":{
        "add": {
          "component_groups": [
            "bullet_r201_blue"
          ]
        },
        "remove": {
          "component_groups": [
            "bullet_r201_red",
            "bullet_charge_red"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "tag @s remove team_red"
          ]
        }
      },
      "team_red":{
        "add": {
          "component_groups": [
            "bullet_r201_red"
          ]
        },
        "remove": {
          "component_groups": [
            "bullet_r201_blue",
            "bullet_charge_blue"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_red",
            "tag @s remove team_blue"
          ]
        }
      },
      // 切换至闲置模式
      "turn_rider_state_normal":{
        "add": {
          "component_groups": [
            "pilot_state_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "pilot_state_aim"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s flash_fire_weapon_all",

            "event entity @e[family=pilot_ai,r=8,c=1] set_other_action_0",
            "tag @s add from_normal",
            "event entity @s[tag=has_target] turn_rider_state_fire",
            
            "tag @e[family=pilot_ai,c=1] add state_self",
            "tag @s add state_self",
            "execute @s[tag=team_blue] ~~~ execute @e[family=pilot,tag=team_red,r=64,rm=16,c=1] ~~~ event entity @e[family=pilot_ai,tag=state_self,c=1] turn_pilot_state_spurt",
            "execute @s[tag=team_red] ~~~ execute @e[family=pilot,tag=team_blue,r=64,rm=16,c=1] ~~~ event entity @e[family=pilot_ai,tag=state_self,c=1] turn_pilot_state_spurt",
            "execute @s[tag=team_blue] ~~~ execute @e[family=pilot,tag=team_red,r=16,c=1] ~~~ event entity @e[type=coldsink:pilot_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "execute @s[tag=team_red] ~~~ execute @e[family=pilot,tag=team_blue,r=16,c=1] ~~~ event entity @e[type=coldsink:pilot_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "tag @e[family=pilot_ai] remove state_self",
            "tag @s remove state_self"
          ]
        }
      },
      // 切换至瞄准模式
      "turn_rider_state_aim":{
        "add": {
          "component_groups": [
            "pilot_state_aim"
          ]
        },
        "remove": {
          "component_groups": [
            "pilot_state_normal"
          ]
        }
      },
      // 切换至开火模式
      "turn_rider_state_fire":{
        "remove": {
          "component_groups": [
            "pilot_state_normal",
            "pilot_state_aim"
          ]
        },
        "queue_command": {
          "command": [
            "execute @s[tag=!from_normal] ~~~ event entity @e[family=pilot_ai,r=8,c=1] set_other_action_1",
            "tag @s remove from_normal",
            "tag @s add from_fire",
            "event entity @s flash_fire_weapon_all"
          ]
        }
      },
      // 刷新武器开火模式
      "flash_fire_weapon_all": {
        "remove": {
          "component_groups": [
            "pilot_state_fire_r201",
            "pilot_state_fire_charge"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=from_fire,scores={pilot_weapon=1}] turn_rider_state_fire_r201",
            "event entity @s[tag=from_fire,scores={pilot_weapon=2}] turn_rider_state_fire_charge",
            "tag @s remove from_fire"
          ]
        }
      },
      // 切换至开火模式-R201
      "turn_rider_state_fire_r201":{
        "add": {
          "component_groups": [
            "pilot_state_fire_r201"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=team_blue] turn_bullet_r201_blue",
            "event entity @s[tag=team_red] turn_bullet_r201_red"
          ]
        }
      },
      // 切换至开火模式-电笔
      "turn_rider_state_fire_charge":{
        "add": {
          "component_groups": [
            "pilot_state_fire_charge"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=team_blue] turn_bullet_charge_blue",
            "event entity @s[tag=team_red] turn_bullet_charge_red"
          ]
        }
      },
      // 切换至主武器
      "turn_rider_weapon_main": {
        "remove": {
          "component_groups": [
            "weapon_off"
          ]
        },
        "add": {
          "component_groups": [
            "weapon_main"
          ]
        },
        "queue_command": {
          "command": [
            "scoreboard players set @s pilot_weapon 1",
            "event entity @e[family=pilot_ai,r=8,c=1] set_weapon_1",
            "tag @s add from_fire",
            "event entity @s flash_fire_weapon_all"
          ]
        }
      },
      // 切换至副武器
      "turn_rider_weapon_off": {
        "remove": {
          "component_groups": [
            "weapon_main"
          ]
        },
        "add": {
          "component_groups": [
            "weapon_off"
          ]
        },
        "queue_command": {
          "command": [
            "scoreboard players set @s pilot_weapon 2",
            "event entity @e[family=pilot_ai,r=8,c=1] set_weapon_2",
            "tag @s add from_fire",
            "event entity @s flash_fire_weapon_all"
          ]
        }
      },
      // R201子弹
      "turn_bullet_r201_blue": {
        "add": {
          "component_groups": [
            "bullet_r201_blue"
          ]
        }
      },
      "turn_bullet_r201_red": {
        "add": {
          "component_groups": [
            "bullet_r201_red"
          ]
        }
      },
      // 电笔子弹
      "turn_bullet_charge_blue": {
        "add": {
          "component_groups": [
            "bullet_charge_blue"
          ]
        }
      },
      "turn_bullet_charge_red": {
        "add": {
          "component_groups": [
            "bullet_charge_red"
          ]
        }
      },
      // 目标靠近后，随机逃离（闪避模式）或出拳（近战模式）
      "random_normal_or_melee": {
        "queue_command": {
          "command": [
            "scoreboard players random @s random_score 1 10",
            "execute @s[scores={random_score=1..3}] ~~~ event entity @e[family=pilot_ai,r=8,c=1] turn_pilot_state_spurt",
            "execute @s[scores={random_score=4..10}] ~~~ tag @e[family=pilot_ai,r=8,c=1] add begin_melee",
            "execute @s[scores={random_score=4..10}] ~~~ event entity @e[family=pilot_ai,r=8,c=1] turn_pilot_state_melee"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}
