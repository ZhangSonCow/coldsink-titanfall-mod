{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:sliding_jump_tool",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "die": {
        "minecraft:instant_despawn": {
          "remove_child_entities": true
        }
      },
      "roar": {
        "minecraft:behavior.knockback_roar": {
          "priority": 1,
          "duration": 0.1,
          "attack_time": 0.1,
          "knockback_damage": 0,
          "knockback_range": 8,
          "knockback_height_cap": 3,
          "knockback_horizontal_strength": 2,
          "knockback_vertical_strength": 1,
          "knockback_filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "=",
                "value": "player"
              },
              {
                "test": "has_tag",
                "subject": "other",
                "operator": "=",
                "value": "sliding_jump_self"
              }
            ]
          },
          "damage_filters": {
            "all_of": [
              {
                "test": "has_tag",
                "subject": "other",
                "operator": "=",
                "value": "none_have_this"
              }
            ]
          },
          "on_roar_end": {
            "event": "godie"
          },
          "cooldown_time": 0.1
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool" ]
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      }

      //behavivors

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "roar"
          ]
        }
      },
      "godie": {
        "queue_command": {
          "command": [
            "tag @p[tag=sliding_jump_self] remove sliding_jump_self",
            "event entity @s real_godie"
          ]
        }
      },
      "real_godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}
