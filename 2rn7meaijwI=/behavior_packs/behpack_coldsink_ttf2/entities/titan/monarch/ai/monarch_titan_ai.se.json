      "coldsink:titan_skin_1":{"minecraft:skin_id":{"value":1}},
      "coldsink:titan_skin_2":{"minecraft:skin_id":{"value":2}},
      "coldsink:titan_skin_3":{"minecraft:skin_id":{"value":3}},
      "coldsink:titan_skin_4":{"minecraft:skin_id":{"value":4}},
      "coldsink:titan_skin_5":{"minecraft:skin_id":{"value":5}},
      "coldsink:titan_skin_6":{"minecraft:skin_id":{"value":6}},
      "coldsink:titan_skin_7":{"minecraft:skin_id":{"value":7}},
      "coldsink:titan_skin_8":{"minecraft:skin_id":{"value":8}}

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "normal_titan",
            "no_shield_box",
            "titan_state_normal",
            "keep_ai_action",
            "knockback_resistance_1"
          ]
        },
        "queue_command": {
          "command": [
            "function titan/init",
            "scoreboard objectives add monarch_level dummy monarch_level",
            "scoreboard objectives add energy_mutil dummy energy_mutil",
            "scoreboard objectives add missile_count dummy missile_count",
            "scoreboard objectives add random_score dummy random_score",
            "ride @s summon_rider coldsink:monarch_rider_ai",
            "tag @s add is_monarch",
            "tag @s add team_blue",
            "event entity @s random_titan_skin"
          ]
        }
      },
      // 切到常规模式
      "turn_titan_state_normal":{
        "add": {
          "component_groups": [
            "titan_state_normal",
            "keep_ai_action"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_melee",
            "titan_state_spurt"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s remove titan_ai_melee"
          ]
        }
      },
      // 切到近战模式
      "turn_titan_state_melee":{
        "add": {
          "component_groups": [
            "titan_state_melee",
            "keep_ai_action"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_spurt"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=begin_melee,tag=!transform] set_action_11",
            "tag @s remove begin_melee",
            "tag @s add titan_ai_melee"
          ]
        }
      },
      // 切到闪避模式
      "turn_titan_state_spurt":{
        "add": {
          "component_groups": [
            "titan_state_spurt"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_melee",
            "keep_ai_action"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add titan_ai_spurt",
            "tag @s add jump_charge_tiantu_ai",
            "event entity @s remove_knockback_resistance"
          ]
        }
      },
      // 检测是否应该冲刺
      "check_titan_ai_can_spurt": {
        "queue_command": {
          "command": [
            "event entity @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] turn_titan_state_spurt",
            "execute @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] ~~~ playsound titan_spurt_tiantu @a[r=64] ~~~"
          ]
        }
      },
      
      // 随机皮肤
      "random_titan_skin": {
        "queue_command": {
          "command": [
            "scoreboard players random @s monarch_skin 0 10",
            "event entity @s[scores={monarch_skin=1}] titan_skin_1",
            "event entity @s[scores={monarch_skin=2}] titan_skin_2",
            "event entity @s[scores={monarch_skin=3}] titan_skin_3",
            "event entity @s[scores={monarch_skin=4}] titan_skin_4",
            "event entity @s[scores={monarch_skin=5}] titan_skin_5",
            "event entity @s[scores={monarch_skin=6}] titan_skin_6",
            "event entity @s[scores={monarch_skin=7}] titan_skin_7",
            "event entity @s[scores={monarch_skin=8}] titan_skin_8"
          ]
        }
      },
      "titan_skin_1":{"add":{"component_groups":["coldsink:titan_skin_1"]}},
      "titan_skin_2":{"add":{"component_groups":["coldsink:titan_skin_2"]}},
      "titan_skin_3":{"add":{"component_groups":["coldsink:titan_skin_3"]}},
      "titan_skin_4":{"add":{"component_groups":["coldsink:titan_skin_4"]}},
