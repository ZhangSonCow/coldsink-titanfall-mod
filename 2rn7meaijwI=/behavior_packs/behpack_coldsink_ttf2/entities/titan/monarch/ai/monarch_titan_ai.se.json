{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:monarch_titan_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        // 0：闲置，1：降落中，2：落地待机，3：蹲姿登机，4：自然起身，5：曲速降落
        // 6：前方登机、7后方登机、8上方登机、9出机、10被处决，98：处决1，99：处决2
        // 11: 近战、12：开火-常规、13：开火-电弧、14：开火-加速器、15：开火-电弧加速器
        // 16：导弹、17：武装、18：快速武装、19：能量、20能量后摇、21：多目标蓄力、22：多目标发射
        "titan:action": {
          "type": "int",
          "range": [ 0, 100 ],
          "default": 0,
          "client_sync": true
        },
        "titan:team": {
          "type": "int",
          "range": [ 1, 2 ],
          "default": 1,
          "client_sync": true
        },
        "titan:show_health": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        // 帝王一级核心选择
        "titan:monarch_core_one": {
          "type": "int",
          "range": [ 1, 3 ],
          "default": 1,
          "client_sync": true
        },
        // 帝王二级核心选择
        "titan:monarch_core_two": {
          "type": "int",
          "range": [ 1, 3 ],
          "default": 1,
          "client_sync": true
        },
        // 帝王三级核心选择
        "titan:monarch_core_three": {
          "type": "int",
          "range": [ 1, 3 ],
          "default": 1,
          "client_sync": true
        },
        // 帝王当前升级等级
        "titan:monarch_now_level": {
          "type": "int",
          "range": [ 0, 3 ],
          "default": 0,
          "client_sync": true
        }
      },
      "animations": {
        "c.loading": "controller.animation.titan_loading_ctrl.func",
        "loading": "animation.titan_loading.func",
        "loading_fast": "animation.titan_loading_fast.func",
        "loaded": "animation.titan_loaded.func",
        "load_shield": "animation.titan_load_shield.func",
        "standing": "animation.titan_standing.func",
        "entry_loaded_titan": "animation.entry_loaded_titan.func",
        "entry_stand_front": "animation.entry_stand_front.func",
        "entry_stand_back": "animation.entry_stand_back.func",
        "entry_stand_top": "animation.entry_stand_top.func",
        "exit_cabin": "animation.exit_cabin.func",
        
        "c.death": "controller.animation.titan_death.func",
        "c.be_danger": "controller.animation.titan_be_danger.func",

        "c.titan_ai_move": "controller.animation.titan_ai_move.func",
        "titan_ai_move_damage": "animation.titan_ai_move_damage.func",
        "c.titan_knockback_resistance": "controller.animation.titan_knockback_resistance.func",
        "titan_knockback_resistance": "animation.titan_knockback_resistance.func",

        "c.monarch_titan_ai_action": "controller.animation.monarch_titan_ai_action.func",
        "monarch_ai_melee": "animation.monarch_ai_melee.func",
        "monarch_ai_missile": "animation.monarch_ai_missile.func",
        "monarch_ai_missile_final": "animation.monarch_ai_missile_final.func",
        "monarch_ai_missile_final_powering": "animation.monarch_ai_missile_final_powering.func",
        "monarch_ai_reflash": "animation.monarch_ai_reflash.func",
        "monarch_ai_reflash_fast": "animation.monarch_ai_reflash_fast.func",
        "c.monarch_ai_reflash_cooldown": "controller.animation.monarch_ai_reflash_cooldown.func",
        "monarch_ai_reflash_cooldown": "animation.monarch_ai_reflash_cooldown.func",
        "monarch_ai_energy": "animation.monarch_ai_energy.func",
        "monarch_ai_energy_after": "animation.monarch_ai_energy_after.func",

        "c.monarch_upgrade_check": "controller.animation.monarch_upgrade_check.func",

        "c.titan_ai_terminate": "controller.animation.titan_ai_terminate.func",
        "terminate_1": "animation.monarch_ai_terminate_1.func",
        "terminate_1_lock": "animation.monarch_ai_terminate_1_lock.func",
        "terminate_2": "animation.monarch_ai_terminate_2.func",
        "terminate_2_lock": "animation.monarch_ai_terminate_2_lock.func",
        "titan_by_terminate": "animation.titan_by_terminate.func"
      },
      "scripts": {
        "animate": [ 
          "c.loading",
          "c.death",
          "c.be_danger",
          "c.titan_ai_move",
          "c.titan_knockback_resistance",
          {
            "c.monarch_titan_ai_action": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          "c.monarch_ai_reflash_cooldown",
          "c.monarch_upgrade_check",
          "c.titan_ai_terminate"
        ]
      }
    },

    "components": {
      "minecraft:collision_box": {
        "height": 6.8,
        "width": 0
      },
      "minecraft:rideable": {
        "seat_count": 4,
        "family_types": [ "ai_rider_tool", "titan_shield", "rodeo_ride_tool", "tone_target" ],
        "seats": [
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:fire_immune": {},
      // 防护盾卡无敌补丁
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "all_of": [
              {
                "test": "rider_count",
                "subject": "self",
                "operator": "<",
                "value": 2
              },
              {
                "test": "has_tag",
                "subject": "self",
                "value": "titan_shield"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "titan_staic"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "terminate"
              }
            ]
          },
          "event": "turn_no_shield"
        }
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },
      
      "no_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "titan_ai", "ai", "player", "monarch_titan", "tiantu" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "fall",
              "deals_damage": false
            },
            // 防友伤
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_blue"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_blue"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_red"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_red"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            }
          ]
        },
        "minecraft:custom_hit_test": {
          "hitboxes": [
            {
              "width": 1.5,
              "height": 4,
              "pivot": [1.5, 2, 0]
            },
            {
              "width": 1.5,
              "height": 4,
              "pivot": [-1.5, 2, 0]
            },
            {
              "width": 2.5,
              "height": 4,
              "pivot": [0, 5, 0]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [1.5, 5, 0]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [-1.5, 5, 0]
            }
          ]
        }
      },
      "has_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "titan_ai", "player", "monarch_titan", "tiantu", "tool" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": false
            }
          ]
        }
      },

      // 击退抗性
      "knockback_resistance_1": {
        "minecraft:is_stunned": {},
        "minecraft:knockback_resistance": {
          "value": 1.0
        }
      },
      "knockback_resistance_0": {
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      },

      // 泰坦血上限
      "normal_titan": {
        "minecraft:health": {
          "value": 12500,
          "max": 12500
        }
      },
      "final_titan": {
        "minecraft:is_sheared": {},
        "minecraft:health": {
          "value": 17500,
          "max": 17500
        }
      },

      // 再武装冷却
      "coldsink:titan_skill_saddled": {
        "minecraft:is_saddled": {}
      },

      // 保持ai行动
      "keep_ai_action": {
        "minecraft:out_of_control": {},
        // 追击靠近距离
        "minecraft:target_nearby_sensor": {
          "inside_range": 40,
          "on_inside_range": {
            "event": "turn_titan_state_normal",
            "target": "self"
          },
          "outside_range": 40,
          "on_outside_range": {
            "event": "turn_titan_state_melee",
            "target": "self"
          }
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 48,
          "reselect_targets": true,
          "must_see": false,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            // 玩家与泰坦
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_shield"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_staic"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "terminate"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 2
            },
            // 怪物
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 512,
              "priority": 3
            },
            // 优先攻击黄血泰坦（帝王专属）
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "titan_danger"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            },
            // 能量转换奶队友
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "titan"
                  },
                  {
                    "test": "has_tag",
                    "subject": "self",
                    "value": "transform"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 0
            }
          ]
        },
        "minecraft:timer": {
          "time": [ 5.0, 8.0 ],
          "time_down_event": {
            "event": "check_titan_ai_can_spurt",
            "target": "self"
          }
        }
      },
      
      // 0-常规模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:shooter": {
          "def": "arrow"
        }
      },

      // 1-近战模式（靠近目标）
      "titan_state_melee":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:follow_range": {
          "value": 512,
          "max": 512
        },
        "minecraft:attack": {
          "damage": 0
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 1,
          "attack_duration": 0.5,
          "hit_delay_pct": 1,
          "reach_multiplier": 1,
          "require_complete_path": false,
          "track_target": true,
          "y_max_head_rotation": 30
        },
        "minecraft:ageable": {
          "duration": 0.8,
          "grow_up": {
            "event": "turn_titan_state_spurt",
            "target": "self"
          }
        }
      },

      // 2-闪避模式
      "titan_state_spurt":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:movement": {
          "value": 0.7
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 0,
          "max_dist": 40,
          "max_flee": 40,
          "remove_target": false,
          "entity_types": [
            // 玩家、泰坦、电烟
            {
              "filters": {
                "all_of": [
