          "def": "coldsink:monarch_ai_bullet_red<bullet_energy>"
        }
      },
      // 能量场子弹
      "bullet_energy_big_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_energy_big>"
