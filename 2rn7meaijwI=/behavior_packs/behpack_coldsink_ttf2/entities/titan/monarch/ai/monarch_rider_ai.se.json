            "execute @s[tag=!from_normal] ~~~ execute @e[family=monarch_titan,r=8,c=1] ~~~ event entity @s[tag=!monarch_core_11] set_action_12",
            "execute @s[tag=!from_normal] ~~~ execute @e[family=monarch_titan,r=8,c=1] ~~~ event entity @s[tag=monarch_core_11] set_action_13",
            "tag @s remove from_normal",
            "execute @s[tag=team_blue] ~~~ execute @e[family=monarch_titan,tag=team_blue,r=8,c=1] ~~~ execute @s[tag=!monarch_core_11] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=team_blue,r=8,c=1] turn_bullet_weapon_blue",
            "execute @s[tag=team_red] ~~~ execute @e[family=monarch_titan,tag=team_red,r=8,c=1] ~~~ execute @s[tag=!monarch_core_11] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=team_red,r=8,c=1] turn_bullet_weapon_red",
            "execute @s[tag=team_blue] ~~~ execute @e[family=monarch_titan,tag=team_blue,r=8,c=1] ~~~ execute @s[tag=monarch_core_11] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=team_blue,r=8,c=1] turn_bullet_weapon_arc_blue",
            "execute @s[tag=team_red] ~~~ execute @e[family=monarch_titan,tag=team_red,r=8,c=1] ~~~ execute @s[tag=monarch_core_11] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=team_red,r=8,c=1] turn_bullet_weapon_arc_red"
          ]
        }
      },
