{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:monarch_rider_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "ctrl.titan_ai_rider_target": "controller.animation.titan_ai_rider_target.func"
      },
      "scripts": {
        "animate": [
          "ctrl.titan_ai_rider_target"
        ]
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool", "ai_rider_tool", "ai" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 1,
        "width": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      // 射击近战切换距离
      "minecraft:target_nearby_sensor": {
        "inside_range": 16,
        "on_inside_range": {
          "event": "random_normal_or_melee",
          "target": "self"
        },
        "outside_range": 16,
        "on_outside_range": {
          "event": "turn_rider_state_aim",
          "target": "self"
        }
      },
      "minecraft:follow_range": {
        "value": 512,
        "max": 512
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "all_of": [
                {
                  "test": "is_riding",
                  "subject": "self",
                  "operator": "!="
                }
              ]
            }
          ]
        }
      },
      // 索敌
      "minecraft:behavior.nearest_prioritized_attackable_target": {
        "priority": 1,
        "within_radius": 80,
        "reselect_targets": true,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "entity_types": [
          // 玩家与泰坦
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_shield"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_staic"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "terminate"
                }
              ]
            },
            "max_dist": 512,
            "priority": 1
          },
          // 怪物
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 512,
            "priority": 2
          }
        ]
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },

      // 随机技能：导弹、能量
      "random_skill": {
        "minecraft:timer": {
          "time": [ 5.0, 8.0 ],
          "time_down_event": {
            "event": "random_skill",
            "target": "self"
          }
        }
      },
      
      // 闲置模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:attack": {
          "damage": 1
        },
        "minecraft:behavior.melee_attack": {
          "track_target": true,
          "reach_multiplier": 0
        }
      },
      // 瞄准模式
      "titan_state_aim":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:ageable": {
          "duration": 0.8,
          "grow_up": {
            "event": "turn_rider_state_fire_before",
            "target": "self"
          }
        }
      },
      // 武器模式-常规
      "titan_state_fire":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.24,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 武器模式-加速器
      "titan_state_fire_final":{
        "minecraft:variant": {
          "value": 3
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.1,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 导弹模式
      "titan_state_missile":{
        "minecraft:variant": {
          "value": 4
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.1,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 能量模式
      "titan_state_energy":{
        "minecraft:variant": {
          "value": 5
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval_min": 0.5,
          "attack_interval_max": 2.5,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 武装模式
      "titan_state_reflash":{
        "minecraft:variant": {
          "value": 6
        }
      },
      // 多目标模式
      "titan_state_missile_final":{
        "minecraft:variant": {
          "value": 7
        }
      },
      // 武器子弹-常规
      "bullet_weapon_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_weapon>"
        }
      },
      "bullet_weapon_red": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_red<bullet_weapon>"
        }
      },
      // 武器子弹-电弧
      "bullet_weapon_arc_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_weapon_arc>"
        }
      },
      "bullet_weapon_arc_red": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_red<bullet_weapon_arc>"
        }
      },
      // 武器子弹-加速器
      "bullet_weapon_final_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_weapon_final>"
        }
      },
      "bullet_weapon_final_red": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_red<bullet_weapon_final>"
        }
      },
      // 武器子弹-电弧加速器
      "bullet_weapon_arc_final_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_weapon_arc_final>"
        }
      },
      "bullet_weapon_arc_final_red": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_red<bullet_weapon_arc_final>"
        }
      },
      // 导弹子弹
      "bullet_missile_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_missile>"
        }
      },
      "bullet_missile_red": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_red<bullet_missile>"
        }
      },
      // 能量子弹
      "bullet_energy_blue": {
        "minecraft:shooter": {
          "def": "coldsink:monarch_ai_bullet_blue<bullet_energy>"
        }
