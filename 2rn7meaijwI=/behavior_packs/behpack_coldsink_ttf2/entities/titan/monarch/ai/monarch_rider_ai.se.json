    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "titan_state_normal",
            "bullet_weapon_blue",
            "random_skill"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "execute @e[family=monarch_titan,c=1] ~~~ execute @s[tag=team_red] ~~~ event entity @e[type=coldsink:monarch_rider_ai,c=1] team_red",
            // 自动泰坦
            "execute @e[family=monarch_titan,c=1] ~~~ execute @s[family=!titan_ai] ~~~ event entity @e[type=coldsink:monarch_rider_ai,c=1] no_random_skill"
          ]
        }
      },
      // 自动泰坦无技能
      "no_random_skill": {
        "remove": {
          "component_groups": [
            "random_skill"
          ]
        }
      },
      // 队伍
      "team_blue":{
        "remove": {
          "component_groups": [
            "bullet_weapon_red",
            "bullet_weapon_red",
            "bullet_weapon_red"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "tag @s remove team_red"
          ]
        }
      },
      "team_red":{
        "remove": {
          "component_groups": [
            "bullet_weapon_blue",
            "bullet_weapon_blue",
            "bullet_weapon_blue"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_red",
            "tag @s remove team_blue"
          ]
        }
      },
      // 切换至闲置模式
      "turn_rider_state_normal":{
        "add": {
          "component_groups": [
            "titan_state_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_aim",
            "titan_state_fire",
            "titan_state_fire_final",
            "titan_state_missile",
            "titan_state_energy",
            "titan_state_reflash",
            "titan_state_missile_final"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @e[family=monarch_titan,r=8,c=1] set_action_0",
            "tag @s add from_normal",
            "event entity @s[tag=has_target] turn_rider_state_fire_before",
            
            "tag @e[family=monarch_titan,c=1] add state_self",
            "tag @s add state_self",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,r=40,rm=24,c=1] ~~~ event entity @e[family=monarch_titan,tag=state_self,c=1] turn_titan_state_spurt",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,r=40,rm=24,c=1] ~~~ event entity @e[family=monarch_titan,tag=state_self,c=1] turn_titan_state_spurt",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,r=24,c=1] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,r=24,c=1] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "tag @e[family=monarch_titan] remove state_self",
            "tag @s remove state_self"
          ]
        }
      },
      // 切换至瞄准模式
      "turn_rider_state_aim":{
        "add": {
          "component_groups": [
            "titan_state_aim"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_fire",
            "titan_state_fire_final",
            "titan_state_missile",
            "titan_state_energy",
            "titan_state_reflash",
            "titan_state_missile_final"
          ]
        }
      },
      "turn_rider_state_fire_before": {
        "queue_command": {
          "command": [
            "execute @e[family=monarch_titan,r=8,c=1] ~~~ execute @s[tag=!monarch_core_33] ~~~ event entity @e[type=coldsink:monarch_rider_ai,r=8,c=1] turn_rider_state_fire",
            "execute @e[family=monarch_titan,r=8,c=1] ~~~ execute @s[tag=monarch_core_33] ~~~ event entity @e[type=coldsink:monarch_rider_ai,r=8,c=1] turn_rider_state_fire_final"
