      // 转换回武器子弹通用事件
      "turn_bullet_weapon_common": {
        "queue_command": {
          "command": [
            "execute @s[tag=team_blue] ~~~ execute @e[family=monarch_titan,tag=team_blue,r=8,c=1] ~~~ execute @s[tag=!monarch_core_11] ~~~ event entity @e[type=coldsink:monarch_rider_ai,tag=team_blue,r=8,c=1] turn_bullet_weapon_blue",
