      "fly_3": {
        "queue_command": {
          "command": [
            "execute @s[tag=get_target] ~~~ detect ^^0.1^1.6 air -1 tp @s ^^0.1^1.6",
            "execute @s[tag=!get_target] ~~~ detect ^^0.1^-1.6 air -1 tp @s ^^0.1^-1.6",
            "execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] ~~5~ event entity @e[type=coldsink:monarch_trace_missile_blue,r=8,c=1] shot_tar"
          ]
        }
      },
      "shot_tar": {
        "queue_command": {
          "command": [
            "execute @s[tag=!get] ~~-5~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] ~~~ execute @s[tag=ronin_defend] ~~~ tag @e[type=coldsink:monarch_trace_missile_blue,c=1] add get_1",
