            "execute @s[tag=!get] ~~-5~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] ~~~ execute @s[tag=titan_hard] ~~~ tag @e[type=coldsink:monarch_trace_missile_blue,c=1] add get_3",
            "execute @s[tag=!get] ~~-5~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] ~~~ execute @s[family=!shield_entity] ~~~ tag @e[type=coldsink:monarch_trace_missile_blue,c=1] add get_core",
            "execute @s[tag=!get] ~~-5~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] ~~~ tag @e[type=coldsink:monarch_trace_missile_blue,c=1] add get",

            "execute @s[tag=get,tag=!done] ~~~ scoreboard players operation @e[tag=is_monarch,tag=team_blue] bullet_check = @s titan_self",
            "execute @s[tag=get,tag=!done] ~~~ execute @e[tag=is_monarch,tag=team_blue] ~~~ scoreboard players operation @s bullet_check -= @s titan_self",
            "execute @s[tag=get,tag=!get_1,tag=!get_2,tag=!get_3,tag=get_core,tag=!done] ~~~ scoreboard players add @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0}] titan_attack 580",
            "execute @s[tag=get_1,tag=get_core,tag=!done] ~~~ scoreboard players add @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0}] titan_attack 174",
            "execute @s[tag=get_2,tag=get_core,tag=!done] ~~~ scoreboard players add @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0}] titan_attack 58",
            "execute @s[tag=get_3,tag=get_core,tag=!done] ~~~ scoreboard players add @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0}] titan_attack 464",
            "execute @s[tag=get,tag=get_core,tag=!done] ~~~ event entity @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0}] shoot_get_core",

            "execute @s[tag=get,tag=!done] ~~-5~ scoreboard players operation @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] death_check = @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0},c=1] titan_self",
            "execute @s[tag=get,tag=!get_1,tag=!get_2,tag=!get_3,tag=!done] ~~-5~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] 580 suicide entity @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0},c=1]",
            "execute @s[tag=get_1,tag=!done] ~~-5~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] 174 suicide entity @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0},c=1]",
            "execute @s[tag=get_2,tag=!done] ~~-5~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] 58 suicide entity @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0},c=1]",
            "execute @s[tag=get_3,tag=!done] ~~-5~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] 464 suicide entity @e[tag=is_monarch,tag=team_blue,scores={bullet_check=0},c=1]",
            "execute @s[tag=get,tag=!done] ~~-5~ event entity @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=8,c=1] defend_damage_transform",

            // 破盾伤害
            "execute @s[tag=get] ~~-5~ damage @e[family=shield_entity,family=!titan_shield,tag=!team_blue,r=8,c=1] 580 suicide entity @s",

            "event entity @s[tag=get] godie",
            "tag @s[tag=get,tag=!done] add done"
