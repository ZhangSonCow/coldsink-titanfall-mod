{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:northstar_titan",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        // 0：闲置，1：降落中，2：落地待机，3：蹲姿登机，4：自然起身，5：曲速降落
        // 6：前方登机、7后方登机、8上方登机、9出机、10被处决，98：处决1，99：处决2
        // 11: 近战、12：开火蓄力、13：开火后摇、14：飞弹、15：核心
        "titan:action": {
          "type": "int",
          "range": [ 0, 100 ],
          "default": 0,
          "client_sync": true
        },
        "titan:team": {
          "type": "int",
          "range": [ 1, 2 ],
          "default": 1,
          "client_sync": true
        },
        "titan:show_health": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        "titan:loading_player": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      },
      "animations": {
        "c.loading": "controller.animation.titan_loading_ctrl.func",
        "loading": "animation.titan_loading.func",
        "loading_fast": "animation.titan_loading_fast.func",
        "c.loading_player": "controller.animation.titan_loading_player.func",
        "loading_fast_player": "animation.loading_fast_player.func",
        "loaded": "animation.titan_loaded.func",
        "load_shield": "animation.titan_load_shield.func",
        "standing": "animation.titan_standing.func",
        "entry_loaded_titan": "animation.entry_loaded_titan.func",
        "entry_stand_front": "animation.entry_stand_front.func",
        "entry_stand_back": "animation.entry_stand_back.func",
        "entry_stand_top": "animation.entry_stand_top.func",
        "exit_cabin": "animation.exit_cabin.func",
        
        "c.death": "controller.animation.titan_death.func",
        "health": "controller.animation.titan_health_3.func",
        "c.be_danger": "controller.animation.titan_be_danger.func",
        "health_danger": "controller.animation.titan_health_danger.func",

        "c.titan_ai_move": "controller.animation.titan_ai_move.func",
        "titan_ai_move_damage": "animation.titan_ai_move_damage.func",
        "c.titan_knockback_resistance": "controller.animation.titan_knockback_resistance.func",
        "titan_knockback_resistance": "animation.titan_knockback_resistance.func",

        "c.northstar_titan_ai_action": "controller.animation.northstar_titan_ai_action.func",
        "northstar_ai_melee": "animation.northstar_ai_melee.func",
        "northstar_ai_missile": "animation.northstar_ai_missile.func",
        "northstar_ai_core": "animation.northstar_ai_core.func",

        "c.northstar_ai_fly": "controller.animation.northstar_ai_fly.func",
        "northstar_ai_fly_trigger": "animation.northstar_ai_fly_trigger.func",
        "northstar_ai_fly": "animation.northstar_ai_fly.func",

        "c.titan_ai_terminate": "controller.animation.titan_ai_terminate.func",
        "terminate_1": "animation.northstar_ai_terminate_1.func",
        "terminate_1_lock": "animation.northstar_ai_terminate_1_lock.func",
        "terminate_2": "animation.northstar_ai_terminate_2.func",
        "terminate_2_lock": "animation.northstar_ai_terminate_2_lock.func",
        "titan_by_terminate": "animation.titan_by_terminate.func",

        "c.drive": "controller.animation.titan_entry_drive.func",
        "c.titan_ai_health_core": "controller.animation.titan_ai_health_core.func",
        "c.flash_titan_health": "controller.animation.flash_titan_health.func",
        "flash_titan_health": "animation.flash_titan_health.func",
        "c.titan_ai_follow": "controller.animation.titan_ai_follow.func"
      },
      "scripts": {
        "animate": [ 
          "c.loading",
          "c.loading_player",
          "c.death",
          "c.be_danger",
          "c.titan_ai_move",
          "c.titan_knockback_resistance",
          {
            "health": "q.is_riding && q.health > 2500"
          },
          {
            "health_danger": "q.is_riding && q.health <= 2500"
          },
          {
            "c.northstar_titan_ai_action": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          // {
          //   "c.northstar_ai_fly": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          // },
          "c.titan_ai_terminate",
          "c.drive",
          {
            "c.titan_ai_health_core": "!q.is_riding"
          },
          "c.flash_titan_health",
          "c.titan_ai_follow"
        ]
      }
    },

    "components": {
      "minecraft:health": {
        "value": 10000,
        "max": 10000
      },
      "minecraft:collision_box": {
        "height": 6.8,
        "width": 0
      },
      "minecraft:rideable": {
        "seat_count": 4,
        "family_types": [ "ai_rider_tool", "titan_shield", "rodeo_ride_tool", "tone_target" ],
        "seats": [
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:fire_immune": {},
      // 防护盾卡无敌补丁
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "all_of": [
              {
                "test": "rider_count",
                "subject": "self",
                "operator": "==",
                "value": 0
              },
              {
                "test": "has_tag",
                "subject": "self",
                "value": "titan_shield"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "titan_staic"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "terminate"
              }
            ]
          },
          "event": "turn_no_shield"
        }
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },
      
      "no_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "player", "northstar_titan", "youxia" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "fall",
              "deals_damage": false
            },
            // 防友伤
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_blue"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_blue"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_red"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_red"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            }
          ]
        },
        "minecraft:custom_hit_test": {
          "hitboxes": [
            {
              "width": 1,
              "height": 4,
              "pivot": [1.5, 2, 0]
            },
            {
              "width": 1,
              "height": 4,
              "pivot": [-1.5, 2, 0]
            },
            {
              "width": 2,
              "height": 4,
              "pivot": [ 0, 5, 0 ]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [1.5, 4.5, 0]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [-1.5, 4.5, 0]
            }
          ]
        }
      },
      "has_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "player", "northstar_titan", "youxia", "tool" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": false
            }
          ]
        }
      },

      // 击退抗性
      "knockback_resistance_1": {
        "minecraft:is_stunned": {},
        "minecraft:knockback_resistance": {
          "value": 1.0
        }
      },
      "knockback_resistance_0": {
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      },

      // 保持ai行动
      "keep_ai_action": {
        "minecraft:out_of_control": {},
        // 追击靠近距离
        "minecraft:target_nearby_sensor": {
          "inside_range": 64,
          "on_inside_range": {
            "event": "turn_titan_state_normal",
            "target": "self"
          },
          "outside_range": 64,
          "on_outside_range": {
            "event": "turn_titan_state_melee",
            "target": "self"
          }
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:timer": {
          "time": [ 3.0, 5.0 ],
          "time_down_event": {
            "event": "check_titan_ai_can_spurt",
            "target": "self"
          }
        }
      },

      // 攻击索敌
      "target_to_enemy": {
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 32,
          "reselect_targets": true,
          "must_see": true,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            // 玩家与泰坦
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_staic"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "terminate"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            },
            // 怪物
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 512,
              "priority": 2
            }
          ]
        }
      },
      
      // 0-常规模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 999
        },
        "minecraft:shooter": {
          "def": "arrow"
        }
      },

      // 1-近战模式（靠近目标）
      "titan_state_melee":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:follow_range": {
          "value": 512,
          "max": 512
        },
        "minecraft:attack": {
          "damage": 0
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 1,
          "attack_duration": 0.5,
          "hit_delay_pct": 1,
          "reach_multiplier": 1,
          "require_complete_path": false,
          "track_target": true,
          "y_max_head_rotation": 30
        },
        "minecraft:ageable": {
          "duration": 3.0,
          "grow_up": {
            "event": "turn_titan_state_spurt",
            "target": "self"
          }
        }
      },

      // 2-闪避模式
      "titan_state_spurt":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:movement": {
          "value": 0.7
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 0,
          "max_dist": 64,
          "max_flee": 64,
          "remove_target": false,
          "entity_types": [
            // 玩家、泰坦、电烟
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "any_of": [
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "player"
                      },
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "titan_elect_smoke"
                      }
                    ]
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            }
          ]
        },
        "minecraft:ageable": {
          "duration": 1.2,
          "grow_up": {
            "event": "turn_titan_state_normal",
            "target": "self"
          }
        }
      },

      // 3-跟随模式
      "titan_state_follow":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:follow_range": {
          "value": 512,
          "max": 512
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 8
        },
        "minecraft:shooter": {
          "def": "arrow"
        },
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 16,
          "reselect_targets": true,
          "must_see": false,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_0" }, { "test": "has_tag", "subject": "other", "value": "titan_player_0" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_1" }, { "test": "has_tag", "subject": "other", "value": "titan_player_1" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_2" }, { "test": "has_tag", "subject": "other", "value": "titan_player_2" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_3" }, { "test": "has_tag", "subject": "other", "value": "titan_player_3" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_4" }, { "test": "has_tag", "subject": "other", "value": "titan_player_4" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_5" }, { "test": "has_tag", "subject": "other", "value": "titan_player_5" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_6" }, { "test": "has_tag", "subject": "other", "value": "titan_player_6" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_7" }, { "test": "has_tag", "subject": "other", "value": "titan_player_7" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_8" }, { "test": "has_tag", "subject": "other", "value": "titan_player_8" } ] }, 
                  { "all_of": [ { "test": "has_tag", "subject": "self", "value": "titan_player_9" }, { "test": "has_tag", "subject": "other", "value": "titan_player_9" } ] } 
                ]
              },
              "max_dist": 512,
              "priority": 0
            }
          ]
        }
      },
      "eject_boom": {
        "minecraft:ageable": {
          "duration": 0.5,
          "grow_up": {
            "event": "eject_end",
            "target": "self"
          }
        }
      },
      "flash_titan_health": {
        "minecraft:is_ignited": {}
      },

      "coldsink:titan_skill_saddled": {
        "minecraft:is_saddled": {}
      },
      
      "coldsink:titan_skin_1":{"minecraft:skin_id":{"value":1}},
      "coldsink:titan_skin_2":{"minecraft:skin_id":{"value":2}},
      "coldsink:titan_skin_3":{"minecraft:skin_id":{"value":3}},
      "coldsink:titan_skin_4":{"minecraft:skin_id":{"value":4}},
      "coldsink:titan_skin_5":{"minecraft:skin_id":{"value":5}},
      "coldsink:titan_skin_6":{"minecraft:skin_id":{"value":6}},
      "coldsink:titan_skin_7":{"minecraft:skin_id":{"value":7}},
      "coldsink:titan_skin_8":{"minecraft:skin_id":{"value":8}}

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "no_shield_box",
            "knockback_resistance_1"
          ]
        },
        "queue_command": {
          "command": [
            "function titan/init",
            "scoreboard objectives add northstar_bullet dummy northstar_bullet",
            "scoreboard objectives add northstar_power dummy northstar_power",
            "scoreboard objectives add random_score dummy random_score",
            "tag @s add is_northstar",
            "tag @s add team_blue",
            "event entity @s[scores={northstar_skin=1}] titan_skin_1",
            "event entity @s[scores={northstar_skin=2}] titan_skin_2",
            "event entity @s[scores={northstar_skin=3}] titan_skin_3",
            "event entity @s[scores={northstar_skin=4}] titan_skin_4",
            "event entity @s[scores={northstar_skin=5}] titan_skin_5",
            "event entity @s[scores={northstar_skin=6}] titan_skin_6",
            "event entity @s[scores={northstar_skin=7}] titan_skin_7",
            "event entity @s[scores={northstar_skin=8}] titan_skin_8"
          ]
        }
      },
      // 切到常规模式
      "turn_titan_state_normal":{
        "add": {
          "component_groups": [
            "titan_state_normal",
            "keep_ai_action",
            "target_to_enemy"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_melee",
            "titan_state_spurt",
            "titan_state_follow"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s remove titan_ai_melee"
          ]
        }
      },
      // 切到近战模式
      "turn_titan_state_melee":{
        "add": {
          "component_groups": [
            "titan_state_melee",
            "keep_ai_action",
            "target_to_enemy"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_spurt",
            "titan_state_follow"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=begin_melee,tag=!in_core] set_action_11",
            "tag @s remove begin_melee",
            "tag @s add titan_ai_melee"
          ]
        }
      },
      // 切到闪避模式
      "turn_titan_state_spurt":{
        "add": {
          "component_groups": [
            "titan_state_spurt"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_melee",
            "titan_state_follow",
            "keep_ai_action",
            "target_to_enemy"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add titan_ai_spurt",
            "tag @s add jump_charge_youxia_ai",
            "event entity @s remove_knockback_resistance"
          ]
        }
      },
      // 切到跟随模式
      "turn_titan_state_follow":{
        "add": {
          "component_groups": [
            "titan_state_follow"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_melee",
            "titan_state_spurt",
            "keep_ai_action",
            "target_to_enemy"
          ]
        }
      },
      // 检测是否应该冲刺
      "check_titan_ai_can_spurt": {
        "queue_command": {
          "command": [
            "event entity @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] turn_titan_state_spurt",
            "execute @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] ~~~ playsound titan_spurt_youxia @a[r=64] ~~~"
          ]
        }
      },

      // 共存技能
      "add_titan_saddled": {
        "add": {
          "component_groups": [
            "coldsink:titan_skill_saddled"
          ]
        }
      },
