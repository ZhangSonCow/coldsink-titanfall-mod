{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:ronin_titan_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        // 0：闲置，1：降落中，2：落地待机，3：蹲姿登机，4：自然起身，5：曲速降落
        // 6：前方登机、7后方登机、8上方登机、9出机、10被处决，98：处决1，99：处决2
        // 11: 近战、12：开火、13：电弧、14：电弧后摇、15：剑封
        "titan:action": {
          "type": "int",
          "range": [ 0, 100 ],
          "default": 0,
          "client_sync": true
        },
        "titan:team": {
          "type": "int",
          "range": [ 1, 2 ],
          "default": 1,
          "client_sync": true
        },
        "titan:show_health": {
          "type": "bool",
          "default": true,
          "client_sync": true
        }
      },
      "animations": {
        "c.loading": "controller.animation.titan_loading_ctrl.func",
        "loading": "animation.titan_loading.func",
        "loading_fast": "animation.titan_loading_fast.func",
        "loaded": "animation.titan_loaded.func",
        "load_shield": "animation.titan_load_shield.func",
        "standing": "animation.titan_standing.func",
        "entry_loaded_titan": "animation.entry_loaded_titan.func",
        "entry_stand_front": "animation.entry_stand_front.func",
        "entry_stand_back": "animation.entry_stand_back.func",
        "entry_stand_top": "animation.entry_stand_top.func",
        "exit_cabin": "animation.exit_cabin.func",
        
        "c.death": "controller.animation.titan_death.func",
        "c.be_danger": "controller.animation.titan_be_danger.func",

        "c.titan_ai_move": "controller.animation.titan_ai_move.func",
        "titan_ai_move_damage": "animation.titan_ai_move_damage.func",
        "c.titan_knockback_resistance": "controller.animation.titan_knockback_resistance.func",
        "titan_knockback_resistance": "animation.titan_knockback_resistance.func",

        "c.ronin_titan_ai_action": "controller.animation.ronin_titan_ai_action.func",
        "ronin_ai_fire": "animation.ronin_ai_fire.func",
        "ronin_ai_melee": "animation.ronin_ai_melee.func",
        "ronin_ai_arc": "animation.ronin_ai_arc.func",
        "ronin_ai_arc_after": "animation.ronin_ai_arc_after.func",
        "c.ronin_ai_damage_defend_skill": "controller.animation.ronin_ai_damage_defend_skill.func",
        "ronin_ai_defend": "animation.ronin_ai_defend.func",

        "c.ronin_ai_phase": "controller.animation.ronin_ai_phase.func",
        "ronin_ai_phase_trigger": "animation.ronin_ai_phase_trigger.func",
        "ronin_ai_phase": "animation.ronin_ai_phase.func",
        "c.ronin_ai_core": "controller.animation.ronin_ai_core.func",
        "ronin_ai_core": "animation.ronin_ai_core.func",

        "c.titan_ai_terminate": "controller.animation.titan_ai_terminate.func",
        "terminate_1": "animation.ronin_ai_terminate_1.func",
        "terminate_1_lock": "animation.ronin_ai_terminate_1_lock.func",
        "terminate_2": "animation.ronin_ai_terminate_2.func",
        "terminate_2_lock": "animation.ronin_ai_terminate_2_lock.func",
        "titan_by_terminate": "animation.titan_by_terminate.func",

        "c.flash_titan_health": "controller.animation.flash_titan_health.func",
        "flash_titan_health": "animation.flash_titan_health.func"
      },
      "scripts": {
        "animate": [ 
          "c.loading",
          "c.death",
          "c.be_danger",
          "c.titan_ai_move",
          "c.titan_knockback_resistance",
          {
            "c.ronin_titan_ai_action": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.ronin_ai_damage_defend_skill": "q.out_of_control"
          },
          {
            "c.ronin_ai_phase": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.ronin_ai_core": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          "c.titan_ai_terminate",
          "c.flash_titan_health"
        ]
      }
    },

    "components": {
      "minecraft:health": {
        "value": 10000,
        "max": 10000
      },
      "minecraft:collision_box": {
        "height": 6.8,
        "width": 0
      },
      "minecraft:rideable": {
        "seat_count": 4,
        "family_types": [ "ai_rider_tool", "titan_shield", "rodeo_ride_tool", "tone_target" ],
        "seats": [
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          },
          {
            "position": [0, 0, 0],
            "lock_rider_rotation": 1
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:fire_immune": {},
      // 防护盾卡无敌补丁
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "all_of": [
              {
                "test": "rider_count",
                "subject": "self",
                "operator": "<",
                "value": 2
              },
              {
                "test": "has_tag",
                "subject": "self",
                "value": "titan_shield"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "titan_staic"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "terminate"
              },
              {
                "test": "has_tag",
                "subject": "self",
                "operator": "!=",
                "value": "ronin_phase"
              }
            ]
          },
          "event": "turn_no_shield"
        }
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },
      
      "no_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "titan_ai", "ai", "player", "ronin_titan", "youxia" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "defend_damage_transform",
                "target": "self"
              }
            },
            {
              "cause": "fall",
              "deals_damage": false
            },
            // 防友伤
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_blue"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_blue"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_tag",
                      "subject": "self",
                      "value": "team_red"
                    },
                    {
                      "test": "has_tag",
                      "subject": "other",
                      "value": "team_red"
                    }
                  ]
                }
              },
              "cause": "all",
              "deals_damage": false
            }
          ]
        },
        "minecraft:custom_hit_test": {
          "hitboxes": [
            {
              "width": 1,
              "height": 4,
              "pivot": [1.5, 2, 0]
            },
            {
              "width": 1,
              "height": 4,
              "pivot": [-1.5, 2, 0]
            },
            {
              "width": 2,
              "height": 4,
              "pivot": [ 0, 5, 0 ]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [1.5, 4.5, 0]
            },
            {
              "width": 1,
              "height": 3,
              "pivot": [-1.5, 4.5, 0]
            }
          ]
        }
      },
      "has_shield_box": {
        "minecraft:type_family": {
          "family": [ "titan", "titan_ai", "player", "ronin_titan", "youxia", "tool" ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": false
            }
          ]
        }
      },

      // 击退抗性
      "knockback_resistance_1": {
        "minecraft:is_stunned": {},
        "minecraft:knockback_resistance": {
          "value": 1.0
        }
      },
      "knockback_resistance_0": {
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      },

      "flash_titan_health": {
        "minecraft:is_ignited": {}
      },

      // 保持ai行动
      "keep_ai_action": {
        "minecraft:out_of_control": {},
        // 追击靠近距离
        "minecraft:target_nearby_sensor": {
          "inside_range": 16,
          "on_inside_range": {
            "event": "turn_titan_state_normal",
            "target": "self"
          },
          "outside_range": 16,
          "on_outside_range": {
            "event": "turn_titan_state_melee",
            "target": "self"
          }
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 16,
          "reselect_targets": true,
          "must_see": false,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            // 玩家与泰坦
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_staic"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "terminate"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            },
            // 怪物
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 512,
              "priority": 2
            }
          ]
        },
        "minecraft:timer": {
          "time": [ 3.0, 5.0 ],
          "time_down_event": {
            "event": "check_titan_ai_can_spurt",
            "target": "self"
          }
        }
      },
      
      // 0-常规模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:shooter": {
          "def": "arrow"
        }
      },

      // 1-近战模式（靠近目标）
      "titan_state_melee":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.5
        },
        "minecraft:follow_range": {
          "value": 512,
          "max": 512
        },
        "minecraft:attack": {
          "damage": 0
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 1,
          "attack_duration": 0.5,
          "hit_delay_pct": 1,
          "reach_multiplier": 1,
          "require_complete_path": false,
          "track_target": true,
          "y_max_head_rotation": 30
        },
        "minecraft:ageable": {
          "duration": 3.0,
          "grow_up": {
            "event": "turn_titan_state_spurt",
            "target": "self"
          }
        }
      },

      // 2-闪避模式
      "titan_state_spurt":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:movement": {
          "value": 0.7
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 0,
          "max_dist": 16,
          "max_flee": 16,
          "remove_target": false,
          "entity_types": [
            // 玩家、泰坦、电烟
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "any_of": [
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "player"
                      },
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "titan_elect_smoke"
                      }
                    ]
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            }
          ]
        },
        "minecraft:ageable": {
          "duration": 1.2,
          "grow_up": {
            "event": "turn_titan_state_normal",
            "target": "self"
          }
        }
      },

      "coldsink:titan_skill_saddled": {
        "minecraft:is_saddled": {}
      },
      "coldsink:titan_skill_sheared": {
        "minecraft:is_sheared": {}
      },
      
      "coldsink:titan_skin_1":{"minecraft:skin_id":{"value":1}},
      "coldsink:titan_skin_2":{"minecraft:skin_id":{"value":2}},
      "coldsink:titan_skin_3":{"minecraft:skin_id":{"value":3}},
      "coldsink:titan_skin_4":{"minecraft:skin_id":{"value":4}},
      "coldsink:titan_skin_5":{"minecraft:skin_id":{"value":5}},
      "coldsink:titan_skin_6":{"minecraft:skin_id":{"value":6}},
      "coldsink:titan_skin_7":{"minecraft:skin_id":{"value":7}},
      "coldsink:titan_skin_8":{"minecraft:skin_id":{"value":8}}

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "no_shield_box",
            "titan_state_normal",
            "keep_ai_action",
            "knockback_resistance_1"
          ]
        },
        "queue_command": {
          "command": [
            "function titan/init",
            "scoreboard objectives add ronin_defend dummy ronin_defend",
            "scoreboard objectives add random_score dummy random_score",
            "scoreboard objectives add slip_bool dummy slip_bool",
            "ride @s summon_rider coldsink:ronin_rider_ai",
            "tag @s add is_ronin",
            "tag @s add team_blue",
            "event entity @s random_titan_skin"
          ]
        }
      },
      // 切到常规模式
      "turn_titan_state_normal":{
        "add": {
          "component_groups": [
            "titan_state_normal",
            "keep_ai_action"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_melee",
            "titan_state_spurt"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s remove titan_ai_melee"
          ]
        }
      },
      // 切到近战模式
      "turn_titan_state_melee":{
        "add": {
          "component_groups": [
            "titan_state_melee",
            "keep_ai_action"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_spurt"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=begin_melee,tag=!ronin_phase] set_action_11",
            "tag @s remove begin_melee",
            "tag @s add titan_ai_melee"
          ]
        }
      },
      // 切到闪避模式
      "turn_titan_state_spurt":{
        "add": {
          "component_groups": [
            "titan_state_spurt"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_melee",
            "keep_ai_action"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add titan_ai_spurt",
            "tag @s add jump_charge_youxia_ai",
            "event entity @s remove_knockback_resistance"
          ]
        }
      },
      // 检测是否应该冲刺
      "check_titan_ai_can_spurt": {
        "queue_command": {
          "command": [
            "event entity @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] turn_titan_state_spurt",
            "execute @s[tag=is_moving,tag=!titan_ai_melee,tag=!no_spurt] ~~~ playsound titan_spurt_youxia @a[r=64] ~~~"
          ]
        }
      },

      // 共存技能
      "add_titan_saddled": {
        "add": {
          "component_groups": [
            "coldsink:titan_skill_saddled"
          ]
        }
      },
      "clear_titan_saddled": {
        "remove": {
          "component_groups": [
            "coldsink:titan_skill_saddled"
          ]
        }
      },
      "add_titan_sheared": {
        "add": {
          "component_groups": [
            "coldsink:titan_skill_sheared"
          ]
        }
      },
      "clear_titan_sheared": {
        "remove": {
          "component_groups": [
            "coldsink:titan_skill_sheared"
          ]
        }
      },

      // 剑封
      "entry_sword_defend": {
        "queue_command": {
          "command": [
            "effect @s resistance 99999 2 true",
            "tag @s add ronin_defending",
            "tag @s add ronin_defend",
            "tag @s remove ronin_defend_core",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] add ronin_defending",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] add ronin_defend",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] remove ronin_defend_core"
          ]
        }
      },
      "entry_sword_defend_core": {
        "queue_command": {
          "command": [
            "effect @s resistance 99999 4 true",
            "tag @s add ronin_defending",
            "tag @s add ronin_defend_core",
            "tag @s remove ronin_defend",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] add ronin_defending",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] add ronin_defend_core",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] remove ronin_defend"
          ]
        }
      },
      "exit_sword_defend": {
        "queue_command": {
          "command": [
            "effect @s resistance 0 5 true",
            "tag @s remove ronin_defending",
            "tag @s remove ronin_defend",
            "tag @s remove ronin_defend_core",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] remove ronin_defending",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] remove ronin_defend",
            "execute @s[tag=titan_shield] ~~~ tag @e[family=titan_shield,r=8,c=1] remove ronin_defend_core"
          ]
        }
      },
      "defend_damage_transform": {
        "queue_command": {
          "command": [
            "event entity @s[tag=!has_rider,tag=ronin_defending] flash_titan_health",
            "execute @s[tag=has_rider,tag=ronin_defending] ~~~ event entity @p[tag=is_ronin,r=8] ronin_defend_reflash",
            "scoreboard players random @s[tag=ronin_defending] random_score 1 3",
            "execute @s[tag=ronin_defending,scores={random_score=1}] ~~~ playsound ronin_defend_impact @a[r=64] ~~~ 3 1 3",
            "execute @s[tag=ronin_defending,scores={random_score=2}] ~~~ playsound ronin_defend_impact @a[r=64] ~~~ 3 0.8 3",
            "execute @s[tag=ronin_defending,scores={random_score=3}] ~~~ playsound ronin_defend_impact @a[r=64] ~~~ 3 1.2 3"
          ]
        }
      },
      
      "flash_titan_health": {
        "add": {
          "component_groups": [
            "flash_titan_health"
          ]
        }
      },
      "flash_titan_health_done": {
        "remove": {
          "component_groups": [
            "flash_titan_health"
          ]
        }
      },
      
      // 随机皮肤
      "random_titan_skin": {
        "queue_command": {
          "command": [
            "scoreboard players random @s ronin_skin 0 10",
            "event entity @s[scores={ronin_skin=1}] titan_skin_1",
            "event entity @s[scores={ronin_skin=2}] titan_skin_2",
