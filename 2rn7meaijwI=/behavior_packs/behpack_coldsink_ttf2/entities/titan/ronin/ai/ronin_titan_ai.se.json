            "tag @s add ronin_melee_self",
            "execute @s ^^^5 scoreboard players operation @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10] death_check = @s titan_self",
            "execute @s ^^^5 scoreboard players operation @e[tag=!team_red,family=titan,tag=titan_danger,tag=!terminate,tag=!ronin_phase,r=10,c=1] terminate_check = @s titan_self",
            "execute @s[tag=!in_core] ^^^5 execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10] ~~~ scoreboard players add @e[type=coldsink:ronin_titan_ai,tag=ronin_melee_self,c=1] titan_attack 800",
            "execute @s[tag=!in_core] ^^^5 execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ event entity @e[type=coldsink:ronin_titan_ai,tag=ronin_melee_self,c=1] shoot_get_core",
            "execute @s[tag=!in_core] ^^^5 damage @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10] 800 suicide entity @s",
            "execute @s[tag=in_core] ^^^5 damage @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10] 2200 suicide entity @s",
            
            "execute @s[tag=!in_core] ^^^5 execute @e[tag=team_blue,family=titan,tag=!terminate,tag=!ronin_phase,r=8,c=1] ~~~ execute @s[tag=titan_danger] ~~~ event entity @e[type=coldsink:ronin_titan_ai,tag=ronin_melee_self,c=1] set_action_98",
            "tag @s remove ronin_melee_self"
