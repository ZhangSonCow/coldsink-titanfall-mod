            "execute @s[tag=team_blue] ~~~ summon coldsink:titan_elect_smoke_blue",
            "execute @s[tag=team_red] ~~~ summon coldsink:titan_elect_smoke_red",
            "scoreboard players operation @e[type=coldsink:titan_elect_smoke_blue,c=1] titan_self = @s[tag=team_blue] titan_self",
            "scoreboard players operation @e[type=coldsink:titan_elect_smoke_red,c=1] titan_self = @s[tag=team_red] titan_self",
            "tag @s add titan_elesmoke_saied"
          ]
        }
