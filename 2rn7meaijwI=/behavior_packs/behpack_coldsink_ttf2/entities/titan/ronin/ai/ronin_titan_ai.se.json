      // 获取核心值计算
      "shoot_get_core": {
        "queue_command": {
          "command": [
            "scoreboard players operation @s titan_attack_tem = @s titan_attack",
            "scoreboard players operation @s titan_attack_tem /= normal_divisor titan_attack_tem",
            "scoreboard players operation @s titan_core += @s titan_attack_tem",
            "scoreboard players operation @s titan_attack %= normal_divisor titan_attack_tem",

            "event entity @s[scores={titan_core=100..},tag=has_target,tag=!terminate] add_titan_sheared",
            "scoreboard players reset @s[scores={titan_core=100..},tag=has_target,tag=!terminate] titan_core",

            "event entity @s[scores={titan_core=50..},tag=!titan_elesmoke_saied] titan_get_elesmoke"
          ]
        }
      },
