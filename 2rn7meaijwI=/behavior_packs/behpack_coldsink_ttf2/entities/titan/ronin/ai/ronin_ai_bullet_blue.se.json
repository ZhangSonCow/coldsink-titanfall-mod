{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:ronin_ai_bullet_blue",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball",
      "animations": {
        "c.self": "controller.animation.titan_bullet_self.func",
        "self": "animation.ronin_bullet_self.func"
      },
      "scripts": {
        "animate": [ 
          "c.self"
        ]
      }
    },

    "component_groups": {
      "die": {
        "minecraft:instant_despawn": {}
      },

      // 武器子弹
      "bullet_weapon": {
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:ageable": {
          "duration": 3,
          "grow_up": {
            "event": "godie",
            "target": "self"
          }
        },
        "minecraft:projectile": {
          "anchor": 1,
          "offset": [ 0, 5, 0 ],
          "on_hit": {
            "impact_damage": {
              "damage": 0,
              "knockback": false,
              "destroy_on_hit": false
            },
            "definition_event": {
              "affect_projectile": true,
              "affect_shooter": false,
              "affect_target": false,
              "affect_splash_area": false,
              "event_trigger": {
                "event": "shot_tar_weapon",
                "target": "self"
              }
            },
            "stick_in_ground": {
              "shake_time": 1.0
            }
          },
          "power": 8,
          "angle_offset": 0,
          "liquid_inertia": 1,
          "stop_on_hurt": false,
          "uncertainty_base": 12.0
        }
      }
    },
    "components": {
			"minecraft:tick_world": {
				"distance_to_players": 128,
				"never_despawn": false,
				"radius": 2
			},
      "minecraft:type_family": {
        "family": [ "tool", "bullet" ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "bullet_weapon": {
        "add": {
          "component_groups": [
            "bullet_weapon"
          ]
        }
      },
      "shot_tar_weapon": {
        "queue_command": {
          "command": [
            "execute @s[tag=!get] ~~-3~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] ~~~ execute @s[tag=ronin_defend] ~~~ tag @e[type=coldsink:ronin_ai_bullet_blue,c=1] add get_1",
            "execute @s[tag=!get] ~~-3~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] ~~~ execute @s[tag=ronin_defend_core] ~~~ tag @e[type=coldsink:ronin_ai_bullet_blue,c=1] add get_2",
            "execute @s[tag=!get] ~~-3~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] ~~~ execute @s[tag=titan_hard] ~~~ tag @e[type=coldsink:ronin_ai_bullet_blue,c=1] add get_3",
            "execute @s[tag=!get] ~~-3~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] ~~~ execute @s[family=!shield_entity] ~~~ tag @e[type=coldsink:ronin_ai_bullet_blue,c=1] add get_core",
            "execute @s[tag=!get] ~~-3~ execute @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] ~~~ tag @e[type=coldsink:ronin_ai_bullet_blue,c=1] add get",

            "execute @s[tag=get] ~~~ scoreboard players operation @e[family=ronin_titan,tag=team_blue] bullet_check = @s titan_self",
            "execute @s[tag=get] ~~~ execute @e[family=ronin_titan,tag=team_blue] ~~~ scoreboard players operation @s bullet_check -= @s titan_self",
            "execute @s[tag=get,tag=!get_1,tag=!get_2,tag=!get_3,tag=get_core] ~~~ scoreboard players add @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0}] titan_attack 125",
            "execute @s[tag=get_1,tag=get_core] ~~~ scoreboard players add @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0}] titan_attack 38",
            "execute @s[tag=get_2,tag=get_core] ~~~ scoreboard players add @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0}] titan_attack 13",
            "execute @s[tag=get_3,tag=get_core] ~~~ scoreboard players add @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0}] titan_attack 100",
            "execute @s[tag=get,tag=get_core] ~~~ event entity @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0}] shoot_get_core",

            "execute @s[tag=get] ~~-3~ scoreboard players operation @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] death_check = @e[family=ronin_titan,tag=team_blue,scores={bullet_check=0},c=1] titan_self",
            "execute @s[tag=get,tag=!get_1,tag=!get_2,tag=!get_3] ~~-3~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] 125 suicide entity @s",
            "execute @s[tag=get_1] ~~-3~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] 38 suicide entity @s",
            "execute @s[tag=get_2] ~~-3~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] 13 suicide entity @s",
            "execute @s[tag=get_3] ~~-3~ damage @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] 100 suicide entity @s",
            "execute @s[tag=get] ~~-3~ event entity @e[tag=!team_blue,family=!tool,type=!item,type=!xp_orb,tag=!energy_shield,r=10,c=1] defend_damage_transform",
            "kill @s[tag=get]"
          ]
        }
      },
      "down": {
        "queue_command": {
          "command": [
            "summon coldsink:ion_get_bullet_red",
            "event entity @s godie"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}