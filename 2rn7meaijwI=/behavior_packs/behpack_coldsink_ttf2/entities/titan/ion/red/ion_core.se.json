{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:ion_core_red",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball",
      "animations": {
        "c.self": "controller.animation.titan_bullet_self.func",
        "self": "animation.ion_bullet_self.func"
      },
      "scripts": {
        "animate": [ 
          "c.self"
        ]
      }
    },

    "component_groups": {
      "die": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
			"minecraft:tick_world": {
				"distance_to_players": 128,
				"never_despawn": false,
				"radius": 2
			},
      "minecraft:type_family": {
        "family": [ "tool" ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:ageable": {
        "duration": 5,
        "grow_up": {
          "event": "godie",
          "target": "self"
        }
      },
      "minecraft:projectile": {
        "anchor": 1,
        "on_hit": {
          "impact_damage": {
            "damage": 0,
            "knockback": false,
            "destroy_on_hit": false
          },
          "definition_event": {
            "affect_projectile": true,
            "affect_shooter": false,
            "affect_target": false,
            "affect_splash_area": false,
            "event_trigger": {
              "filters": {
                "all_of": [
                  {
                    "test": "on_ground",
                    "operator": "!=",
                    "subject": "self"
                  }
                ]
              },
              "event": "shot_tar",
              "target": "self"
            }
          },
          "stick_in_ground": {
            "shake_time": 1
          }
        },
        "power": 9,
        "angle_offset": 0,
        "liquid_inertia": 1.0,
        "stop_on_hurt": false
      },
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "shot_tar": {
        "queue_command": {
          "command": [
            "scoreboard players operation @a[tag=is_ion,tag=team_red] skill_check_3 = @s titan_self",
            "execute @a[tag=is_ion,tag=team_red] ~~~ scoreboard players operation @s skill_check_3 -= @s titan_self",
            "scoreboard players operation @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] death_check = @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}] titan_self",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ playanimation @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}] animation.feedback_star.1st.zoom",

            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ damage @s[tag=!ronin_defending,tag=!titan_hard] 377 suicide entity @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}]",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ damage @s[tag=ronin_defend] 113 suicide entity @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}]",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ damage @s[tag=ronin_defend_core] 38 suicide entity @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}]",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ damage @s[tag=titan_hard] 302 suicide entity @p[tag=is_ion,tag=team_red,scores={skill_check_3=0}]",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ event entity @s[tag=ronin_defending] defend_damage_transform",
            "execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=10,c=1] ~~~ kill @e[type=coldsink:ion_core_red,c=1]",
            
            // 瞬破粒子盾
            "kill @e[family=particle_shield,tag=!team_red,r=12]",
            
            "kill @s[tag=get]"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}