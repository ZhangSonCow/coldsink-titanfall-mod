      "line_range_17":{"set_property":{"titan:line_range": 17}},
      "line_range_18":{"set_property":{"titan:line_range": 18}},
      "line_range_19":{"set_property":{"titan:line_range": 19}},
      "line_range_20":{"set_property":{"titan:line_range": 20}},
      "line_range_21":{"set_property":{"titan:line_range": 21}},
      "line_range_22":{"set_property":{"titan:line_range": 22}},
      "line_range_23":{"set_property":{"titan:line_range": 23}},
      "line_range_24":{"set_property":{"titan:line_range": 24}},
      "line_range_25":{"set_property":{"titan:line_range": 25}},
      "line_range_26":{"set_property":{"titan:line_range": 26}},
      "line_range_27":{"set_property":{"titan:line_range": 27}},
      "line_range_28":{"set_property":{"titan:line_range": 28}},
      "line_range_29":{"set_property":{"titan:line_range": 29}},
      "line_range_30":{"set_property":{"titan:line_range": 30}},
      // 模拟垂直距离差
      "line_height_1_up":{"set_property":{"titan:line_height": 1}},
      "line_height_2_up":{"set_property":{"titan:line_height": 2}},
      "line_height_3_up":{"set_property":{"titan:line_height": 3}},
      "line_height_4_up":{"set_property":{"titan:line_height": 4}},
      "line_height_5_up":{"set_property":{"titan:line_height": 5}},
      "line_height_6_up":{"set_property":{"titan:line_height": 6}},
      "line_height_7_up":{"set_property":{"titan:line_height": 7}},
      "line_height_8_up":{"set_property":{"titan:line_height": 8}},
      "line_height_9_up":{"set_property":{"titan:line_height": 9}},
      "line_height_10_up":{"set_property":{"titan:line_height": 10}},
      "line_height_1_down":{"set_property":{"titan:line_height": -1}},
      "line_height_2_down":{"set_property":{"titan:line_height": -2}},
      "line_height_3_down":{"set_property":{"titan:line_height": -3}},
      "line_height_4_down":{"set_property":{"titan:line_height": -4}},
      "line_height_5_down":{"set_property":{"titan:line_height": -5}},
      "line_height_6_down":{"set_property":{"titan:line_height": -6}},
      "line_height_7_down":{"set_property":{"titan:line_height": -7}},
      "line_height_8_down":{"set_property":{"titan:line_height": -8}},
      "line_height_9_down":{"set_property":{"titan:line_height": -9}},
      "line_height_10_down":{"set_property":{"titan:line_height": -10}},
      "be_ready": {
        "remove": {
          "component_groups": [
            "before"
          ]
        },
        "add": {
          "component_groups": [
            "ready"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @s[tag=!main] facing_main",
            "event entity @s[tag=main] get_range"
          ]
        }
      },
      // 邻节点对准主节点
      "facing_main": {
        "queue_command": {
          "command": [
            "scoreboard players operation @e[type=coldsink:ion_trap_red,tag=main] bullet_check = @s ion_trap",
            "execute @e[type=coldsink:ion_trap_red,tag=main] ~~~ scoreboard players operation @s bullet_check -= @s ion_trap",
            "tp @s[tag=!main] ~~~ facing @e[type=coldsink:ion_trap_red,tag=main,scores={bullet_check=0},c=1]"
          ]
        }
      },
      "count": {
        "queue_command": {
          "command": [
            "execute @s[tag=main] ~~~ execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,family=!shield_entity,r=6] ~~~ event entity @e[type=coldsink:ion_trap_red,r=6,c=1] boom",
            "execute @s[tag=!main] ^^^3 execute @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,family=!shield_entity,r=6] ~~~ event entity @e[type=coldsink:ion_trap_red,r=6,c=1] boom"
          ]
        }
      },
      "boom": {
        "queue_command": {
          "command": [
            "execute @s[tag=main] ~~~ tag @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=6] add ion_trap_boom",
            "execute @s[tag=!main] ^^^3 tag @e[tag=!team_red,family=!tool,type=!item,type=!xp_orb,r=6] add ion_trap_boom",

            "execute @s[tag=!done] ~~~ execute @e[tag=ion_trap_boom,tag=!ronin_defending,tag=!titan_hard,family=!shield_entity] ~~~ scoreboard players add @e[type=coldsink:ion_trap_red,c=1] titan_attack 1000",
            "execute @s[tag=!done] ~~~ execute @e[tag=ion_trap_boom,tag=ronin_defend,family=!shield_entity] ~~~ scoreboard players add @e[type=coldsink:ion_trap_red,c=1] titan_attack 300",
            "execute @s[tag=!done] ~~~ execute @e[tag=ion_trap_boom,tag=ronin_defend_core,family=!shield_entity] ~~~ scoreboard players add @e[type=coldsink:ion_trap_red,c=1] titan_attack 100",
            "execute @s[tag=!done] ~~~ execute @e[tag=ion_trap_boom,tag=titan_hard,family=!shield_entity] ~~~ scoreboard players add @e[type=coldsink:ion_trap_red,c=1] titan_attack 800",

            "execute @s[scores={titan_attack=1..},tag=!done] ~~~ scoreboard players operation @e[tag=is_ion,tag=team_red] skill_check_2 = @s titan_self",
            "execute @s[scores={titan_attack=1..},tag=!done] ~~~ execute @e[tag=is_ion,tag=team_red] ~~~ scoreboard players operation @s skill_check_2 -= @s titan_self",
            "execute @s[scores={titan_attack=1..},tag=!done] ~~~ scoreboard players operation @e[tag=is_ion,tag=team_red,scores={skill_check_2=0}] titan_attack += @s titan_attack",
            "execute @s[scores={titan_attack=1..},tag=!done] ~~~ event entity @e[tag=is_ion,tag=team_red,scores={skill_check_2=0}] shoot_get_core",

            "execute @s[scores={titan_attack=1..},tag=!done] ~~~ scoreboard players operation @e[tag=!team_red,tag=ion_trap_boom] death_check = @e[tag=is_ion,tag=team_red,scores={skill_check_2=0},c=1] titan_self",
            "execute @s[tag=!done] ~~~ damage @e[tag=!team_red,tag=ion_trap_boom,tag=!ronin_defending,tag=!titan_hard] 1000 suicide entity @e[tag=is_ion,tag=team_red,scores={skill_check_2=0},c=1]",
            "execute @s[tag=!done] ~~~ damage @e[tag=!team_red,tag=ion_trap_boom,tag=ronin_defend] 300 suicide entity @e[tag=is_ion,tag=team_red,scores={skill_check_2=0},c=1]",
            "execute @s[tag=!done] ~~~ damage @e[tag=!team_red,tag=ion_trap_boom,tag=ronin_defend_core] 100 suicide entity @e[tag=is_ion,tag=team_red,scores={skill_check_2=0},c=1]",
            "execute @s[tag=!done] ~~~ damage @e[tag=!team_red,tag=ion_trap_boom,tag=titan_hard] 800 suicide entity @e[tag=is_ion,tag=team_red,scores={skill_check_2=0},c=1]",

            "tag @s add done",

            "tag @e[tag=ion_trap_boom] remove ion_trap_boom",

            // 牵连爆炸
            "tag @s add boom_self",
            "scoreboard players operation @e[type=coldsink:ion_trap_red,tag=!boom_self] bullet_check = @s ion_trap",
            "execute @e[type=coldsink:ion_trap_red,tag=!boom_self] ~~~ scoreboard players operation @s bullet_check -= @s ion_trap",
            "event entity @e[type=coldsink:ion_trap_red,tag=!boom_self,scores={bullet_check=0}] boom",

            "particle titan:ion_trap_boom_1 ~~~",
            "particle titan:ion_trap_boom_2 ~~~",

            "event entity @s godie"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "godie"
          ]
        }
      }
    }
  }
}