{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:scorch_rider_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "ctrl.titan_ai_rider_target": "controller.animation.titan_ai_rider_target.func"
      },
      "scripts": {
        "animate": [
          "ctrl.titan_ai_rider_target"
        ]
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool", "ai_rider_tool", "ai" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 1,
        "width": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      // 射击近战切换距离
      "minecraft:target_nearby_sensor": {
        "inside_range": 16,
        "on_inside_range": {
          "event": "random_normal_or_melee",
          "target": "self"
        },
        "outside_range": 16,
        "on_outside_range": {
          "event": "turn_rider_state_aim",
          "target": "self"
        }
      },
      "minecraft:follow_range": {
        "value": 512,
        "max": 512
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "all_of": [
                {
                  "test": "is_riding",
                  "subject": "self",
                  "operator": "!="
                }
              ]
            }
          ]
        }
      },
      // 索敌
      "minecraft:behavior.nearest_prioritized_attackable_target": {
        "priority": 1,
        "within_radius": 48,
        "reselect_targets": true,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "entity_types": [
          // 玩家与泰坦
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_staic"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "terminate"
                }
              ]
            },
            "max_dist": 512,
            "priority": 1
          },
          // 怪物
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 512,
            "priority": 2
          },
          // 燃烧陷阱
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "self",
                  "value": "scorch_trap_stand"
                },
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "max_dist": 512,
            "priority": 0
          }
        ]
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },

      // 随机技能：火墙、陷阱
      "random_skill": {
        "minecraft:timer": {
          "time": [ 5.0, 8.0 ],
          "time_down_event": {
            "event": "random_skill",
            "target": "self"
          }
        }
      },
      
      // 闲置模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:attack": {
          "damage": 1
        },
        "minecraft:behavior.melee_attack": {
          "track_target": true,
          "reach_multiplier": 0
        }
      },
      // 瞄准模式
      "titan_state_aim":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:ageable": {
          "duration": 0.8,
          "grow_up": {
            "event": "turn_rider_state_fire",
            "target": "self"
          }
        }
      },
      // 武器模式
      "titan_state_fire":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 3.0,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 火墙模式
      "titan_state_firewall":{
        "minecraft:variant": {
          "value": 3
        }
      },
      // 火盾模式
      "titan_state_shield":{
        "minecraft:variant": {
          "value": 5
        }
      },
      // 武器子弹
      "bullet_weapon_blue": {
        "minecraft:shooter": {
          "def": "coldsink:scorch_ai_bullet_blue<bullet_weapon>"
        }
      },
      "bullet_weapon_red": {
        "minecraft:shooter": {
          "def": "coldsink:scorch_ai_bullet_red<bullet_weapon>"
        }
      },
      // 陷阱子弹
      "bullet_trap_blue": {
        "minecraft:spawn_entity": {
          "entities": [
            {
              "min_wait_time": 0,
              "max_wait_time": 0,
              "single_use": true,
              "spawn_entity": "coldsink:scorch_trap_throw_blue",
              "num_to_spawn": 1
            }
          ]
        }
      },
      "bullet_trap_red": {
        "minecraft:spawn_entity": {
          "entities": [
            {
              "min_wait_time": 0,
              "max_wait_time": 0,
              "single_use": true,
              "spawn_entity": "coldsink:scorch_trap_throw_red",
              "num_to_spawn": 1
            }
          ]
        }
      }

    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "titan_state_normal",
            "bullet_weapon_blue",
            "random_skill"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "execute @e[family=scorch_titan,c=1] ~~~ execute @s[tag=team_red] ~~~ event entity @e[type=coldsink:scorch_rider_ai,c=1] team_red",
            // 自动泰坦
            "execute @e[family=scorch_titan,c=1] ~~~ execute @s[family=!titan_ai] ~~~ event entity @e[type=coldsink:scorch_rider_ai,c=1] no_random_skill"
          ]
        }
      },
      // 自动泰坦无技能
      "no_random_skill": {
        "remove": {
          "component_groups": [
            "random_skill"
          ]
        }
      },
      // 队伍
      "team_blue":{
        "remove": {
          "component_groups": [
            "bullet_weapon_red"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "tag @s remove team_red"
          ]
        }
      },
      "team_red":{
        "remove": {
          "component_groups": [
            "bullet_weapon_blue"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add team_red",
            "tag @s remove team_blue"
          ]
        }
      },
      // 切换至闲置模式
      "turn_rider_state_normal":{
        "add": {
          "component_groups": [
            "titan_state_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_aim",
            "titan_state_fire",
            "titan_state_firewall",
            "titan_state_shield"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @e[family=scorch_titan,r=8,c=1] set_action_0",
            "tag @s add from_normal",
            "event entity @s[tag=has_target] turn_rider_state_fire",
            
            "tag @e[family=scorch_titan,c=1] add state_self",
            "tag @s add state_self",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,r=24,rm=16,c=1] ~~~ event entity @e[family=scorch_titan,tag=state_self,c=1] turn_titan_state_spurt",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,r=24,rm=16,c=1] ~~~ event entity @e[family=scorch_titan,tag=state_self,c=1] turn_titan_state_spurt",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,r=16,c=1] ~~~ event entity @e[type=coldsink:scorch_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,r=16,c=1] ~~~ event entity @e[type=coldsink:scorch_rider_ai,tag=state_self,c=1] random_normal_or_melee",
            "tag @e[family=scorch_titan] remove state_self",
            "tag @s remove state_self"
          ]
        }
      },
      // 切换至瞄准模式
      "turn_rider_state_aim":{
        "add": {
          "component_groups": [
            "titan_state_aim"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_fire",
            "titan_state_firewall",
            "titan_state_shield"
          ]
        }
      },
      // 切换至开火模式
      "turn_rider_state_fire":{
        "add": {
          "component_groups": [
            "titan_state_fire"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_aim",
            "titan_state_firewall",
            "titan_state_shield"
          ]
        },
        "queue_command": {
          "command": [
            "execute @s[tag=!from_normal] ~~~ event entity @e[family=scorch_titan,r=8,c=1] set_action_12",
            "tag @s remove from_normal",
            "event entity @s[tag=team_blue] turn_bullet_weapon_blue",
            "event entity @s[tag=team_red] turn_bullet_weapon_red"
          ]
        }
      },
      "turn_bullet_weapon_blue": {
        "add": {
          "component_groups": [
            "bullet_weapon_blue"
          ]
        },
        "remove": {
          "component_groups": [
            "bullet_trap_blue"
          ]
        }
      },
      "turn_bullet_weapon_red": {
        "add": {
          "component_groups": [
            "bullet_weapon_red"
          ]
        },
        "remove": {
          "component_groups": [
            "bullet_trap_red"
          ]
        }
      },
      // 切换至火墙模式
      "turn_rider_state_firewall":{
        "add": {
          "component_groups": [
            "titan_state_firewall"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_aim",
            "titan_state_fire",
            "titan_state_firewall",
            "titan_state_shield"
          ]
        },
        "queue_command": {
          "command": [
            "event entity @e[family=scorch_titan,r=8,c=1] set_action_13"
          ]
        }
      },
      // 投掷陷阱
      "shoot_bullet_trap_blue": {
        "add": {
          "component_groups": [
            "bullet_trap_blue"
          ]
        }
      },
      "shoot_bullet_trap_red": {
        "add": {
          "component_groups": [
            "bullet_trap_red"
          ]
        }
      },
      // 切换至火盾模式
      "turn_rider_state_shield":{
        "add": {
          "component_groups": [
            "titan_state_shield"
          ]
        },
        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_aim",
            "titan_state_fire",
            "titan_state_firewall"
          ]
        },
        "queue_command": {
          "command": [
            // 暂时固定为仅人机泰坦AI可使用火盾，后面根据智慧芯片
            "execute @e[family=scorch_titan,r=8,c=1] ~~~ event entity @s[family=titan_ai,tag=!terminate] set_action_15"
          ]
        }
      },
      // 目标靠近后，随机逃离（闪避模式）或出拳（近战模式）
      "random_normal_or_melee": {
        "queue_command": {
          "command": [
            // 若周身有黄血敌方泰坦
            "tag @s add state_self",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,tag=titan_danger,r=16,c=1] ~~~ tag @e[type=coldsink:scorch_rider_ai,tag=team_blue,tag=state_self,c=1] add get_titan_danger",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,tag=titan_danger,r=16,c=1] ~~~ tag @e[type=coldsink:scorch_rider_ai,tag=team_red,tag=state_self,c=1] add get_titan_danger",
            "tag @s remove state_self",

            // 则自动泰坦必定闪避，泰坦AI必定近战
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=scorch_titan,r=8,c=1] ~~~ event entity @s[family=!titan_ai] turn_titan_state_spurt",
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=scorch_titan,r=8,c=1] ~~~ tag @s[family=titan_ai] add begin_melee",
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=scorch_titan,r=8,c=1] ~~~ event entity @s[family=titan_ai] turn_titan_state_melee",

            // 否则随机转换
            "scoreboard players random @s[tag=!get_titan_danger] random_score 1 10",
            "execute @s[scores={random_score=1..3},tag=!get_titan_danger] ~~~ event entity @e[family=scorch_titan,r=8,c=1] turn_titan_state_spurt",
            "execute @s[scores={random_score=4..6},tag=!get_titan_danger] ~~~ tag @e[family=scorch_titan,r=8,c=1] add begin_melee",
            "execute @s[scores={random_score=7..10},tag=!get_titan_danger] ~~~ event entity @e[family=scorch_titan,r=8,c=1] set_action_15",

            "tag @s remove get_titan_danger"
          ]
        }
      },
      // 随机技能：火墙、陷阱
      "random_skill": {
        "queue_command": {
          "command": [
            "scoreboard players random @s random_score 1 10",
            "event entity @s[scores={random_score=1..5},tag=has_target] turn_rider_state_firewall",
            "event entity @s[scores={random_score=6..10},tag=has_target,tag=team_blue] shoot_bullet_trap_blue",
            "event entity @s[scores={random_score=6..10},tag=has_target,tag=team_red] shoot_bullet_trap_red"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}
