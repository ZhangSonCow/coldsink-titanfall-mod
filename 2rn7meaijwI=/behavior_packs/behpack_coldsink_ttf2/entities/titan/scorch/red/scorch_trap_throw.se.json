{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:scorch_trap_throw_red",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball",
      "animations": {
        "c.self": "controller.animation.throw_on_ground.func",
        "self": "animation.scorch_bullet_self.func"
      },
      "scripts": {
        "animate": [ 
          "c.self"
        ]
      }
    },

    "component_groups": {
      "die": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "tool" ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:projectile": {
        "anchor": 1,
        "on_hit": {
          "definition_event": {
            "affect_projectile": true,
            "affect_shooter": false,
            "affect_target": false,
            "affect_splash_area": false
          },
          "stick_in_ground": {
            "shake_time": 1
          }
        },
        "power": 3,
        "gravity": 0.5,
        "angle_offset": 0,
        "liquid_inertia": 1,
        "stop_on_hurt": false
      },
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "beOnGround": {
        "queue_command": {
          "command": [
            "summon coldsink:scorch_trap_red ~~~",
            "scoreboard players operation @e[type=coldsink:scorch_trap_red,c=1] titan_self = @s titan_self",
            "event entity @s godie"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
