{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:legion_rider_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "ctrl.titan_ai_rider_target": "controller.animation.titan_ai_rider_target.func"
      },
      "scripts": {
        "animate": [
          "ctrl.titan_ai_rider_target"
        ]
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool", "ai_rider_tool", "ai" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 1,
        "width": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      // 射击近战切换距离
      "minecraft:target_nearby_sensor": {
        "inside_range": 16,
        "on_inside_range": {
          "event": "random_normal_or_melee",
          "target": "self"
        },
        "outside_range": 16,
        "on_outside_range": {
          "event": "turn_rider_state_aim",
          "target": "self"
        }
      },
      "minecraft:follow_range": {
        "value": 512,
        "max": 512
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "all_of": [
                {
                  "test": "is_riding",
                  "subject": "self",
                  "operator": "!="
                }
              ]
            }
          ]
        }
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      },

      // 索敌-不可透视
      "target_must_see_true": {
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 96,
          "reselect_targets": true,
          "must_see": true,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            // 玩家与泰坦
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_staic"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "terminate"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            },
            // 怪物
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 512,
              "priority": 2
            }
          ]
        }
      },

      // 索敌-可透视
      "target_must_see_false": {
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 1,
          "within_radius": 96,
          "reselect_targets": true,
          "must_see": false,
          "must_see_forget_duration": 1.0,
          "entity_types": [
            // 玩家与泰坦
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_blue"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_blue"
                          }
                        ]
                      },
                      {
                        "all_of": [
                          {
                            "test": "has_tag",
                            "subject": "self",
                            "value": "team_red"
                          },
                          {
                            "test": "has_tag",
                            "subject": "other",
                            "operator": "!=",
                            "value": "team_red"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "titan_staic"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "terminate"
                  }
                ]
              },
              "max_dist": 512,
              "priority": 1
            },
            // 怪物
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 512,
              "priority": 2
            }
          ]
        }
      },

      // 随机技能：强火
      "random_skill": {
        "minecraft:timer": {
          "time": [ 5.0, 8.0 ],
          "time_down_event": {
            "event": "random_skill",
            "target": "self"
          }
        }
      },
      
      // 闲置模式
      "titan_state_normal":{
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:attack": {
          "damage": 1
        },
        "minecraft:behavior.melee_attack": {
          "track_target": true,
          "reach_multiplier": 0
        }
      },
      // 瞄准模式
      "titan_state_aim":{
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 999,
          "burst_shots": 1,
          "attack_radius": 128
        },
        "minecraft:ageable": {
          "duration": 1.5,  // 更长预瞄时间
          "grow_up": {
            "event": "turn_rider_state_fire",
            "target": "self"
          }
        }
      },
      // 武器模式
      "titan_state_fire":{
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.18,
          "burst_shots": 1,
          "attack_radius": 128
        }
      },
      // 强火模式-近程
      "titan_state_power_near":{
        "minecraft:variant": {
          "value": 3
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 0,
          "attack_interval": 0.8,
          "burst_shots": 10,
          "attack_radius": 128
        }
      },
      // 强火模式-远程
      "titan_state_power_far":{
        "minecraft:variant": {
          "value": 4
