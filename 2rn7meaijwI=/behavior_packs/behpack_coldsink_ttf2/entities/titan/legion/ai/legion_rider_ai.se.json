      // 目标靠近后，随机逃离（闪避模式）或出拳（近战模式）
      "random_normal_or_melee": {
        "queue_command": {
          "command": [
            // 若周身有黄血敌方泰坦
            "tag @s add state_self",
            "execute @s[tag=team_blue] ~~~ execute @e[family=titan,tag=team_red,tag=titan_danger,r=16,c=1] ~~~ tag @e[type=coldsink:legion_rider_ai,tag=team_blue,tag=state_self,c=1] add get_titan_danger",
            "execute @s[tag=team_red] ~~~ execute @e[family=titan,tag=team_blue,tag=titan_danger,r=16,c=1] ~~~ tag @e[type=coldsink:legion_rider_ai,tag=team_red,tag=state_self,c=1] add get_titan_danger",
            "tag @s remove state_self",

            // 则自动泰坦必定闪避，泰坦AI必定近战
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=legion_titan,r=8,c=1] ~~~ event entity @s[family=!titan_ai] turn_titan_state_spurt",
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=legion_titan,r=8,c=1] ~~~ tag @s[family=titan_ai] add begin_melee",
            "execute @s[tag=get_titan_danger] ~~~ execute @e[family=legion_titan,r=8,c=1] ~~~ event entity @s[family=titan_ai] turn_titan_state_melee",

            // 否则随机转换
            "scoreboard players random @s[tag=!get_titan_danger] random_score 1 10",
            "execute @s[scores={random_score=1..7},tag=!get_titan_danger] ~~~ event entity @e[family=legion_titan,r=8,c=1] turn_titan_state_spurt",
            "execute @s[scores={random_score=8..10},tag=!get_titan_danger] ~~~ tag @e[family=legion_titan,r=8,c=1] add begin_melee",
            "execute @s[scores={random_score=8..10},tag=!get_titan_danger] ~~~ event entity @e[family=legion_titan,r=8,c=1] turn_titan_state_melee",

            "tag @s remove get_titan_danger"
          ]
        }
      },
      // 随机技能：强火
      "random_skill": {
        "queue_command": {
          "command": [
            "event entity @s[tag=has_target,tag=!legion_range_mode] turn_rider_state_power_near",
            "event entity @s[tag=has_target,tag=legion_range_mode] turn_rider_state_power_far"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}
