      "bullet_power_far_red": {
        "minecraft:shooter": {
          "def": "coldsink:legion_ai_bullet_red<bullet_power_far>"
        }
      },
      // 武器子弹-核心
      "bullet_core_blue": {
        "minecraft:shooter": {
          "def": "coldsink:legion_ai_bullet_blue<bullet_core>"
