        "remove": {
          "component_groups": [
            "titan_state_normal",
            "titan_state_aim",
            "titan_state_power_near",
            "titan_state_power_far",
            "titan_state_change"
          ]
        },
        "queue_command": {
          "command": [
            "execute @s[tag=!from_normal] ~~~ event entity @e[family=legion_titan,r=8,c=1] set_action_12",
            "execute @s[tag=!from_normal] ~~~ tag @e[family=legion_titan,r=8,c=1] add fire",
            "tag @s remove from_normal",
            "event entity @s[tag=team_blue,tag=!legion_range_mode,tag=!in_core] turn_bullet_weapon_near_blue",
            "event entity @s[tag=team_red,tag=!legion_range_mode,tag=!in_core] turn_bullet_weapon_near_red",
            "event entity @s[tag=team_blue,tag=legion_range_mode,tag=!in_core] turn_bullet_weapon_far_blue",
            "event entity @s[tag=team_red,tag=legion_range_mode,tag=!in_core] turn_bullet_weapon_far_red",
            "event entity @s[tag=team_blue,tag=in_core] turn_bullet_core_blue",
            "event entity @s[tag=team_red,tag=in_core] turn_bullet_core_red"
          ]
        }
      },
