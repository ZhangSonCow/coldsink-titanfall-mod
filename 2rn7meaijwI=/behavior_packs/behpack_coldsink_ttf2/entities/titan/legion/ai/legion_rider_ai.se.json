      "change_weapon_mode": {
        "queue_command": {
          "command": [
            "tag @s add change_mode",

            "tag @s[tag=!legion_range_mode] remove change_mode",
            "execute @s[tag=!legion_range_mode] ~~~ playsound legion_skill_2_to_far @a[r=64] ~~~",
            "tag @s[tag=!legion_range_mode] add legion_range_mode",

            "execute @s[tag=change_mode,tag=legion_range_mode] ~~~ playsound legion_skill_2_to_near @a[r=64] ~~~",
            "tag @s[tag=change_mode,tag=legion_range_mode] remove legion_range_mode",
            "tag @s remove change_mode",

            "event entity @s turn_rider_state_normal"
