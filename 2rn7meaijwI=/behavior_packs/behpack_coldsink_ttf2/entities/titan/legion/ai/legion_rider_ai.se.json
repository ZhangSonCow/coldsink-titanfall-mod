      "bullet_weapon_far_blue": {
        "minecraft:shooter": {
          "def": "coldsink:legion_ai_bullet_blue<bullet_weapon_far>"
        }
      },
      "bullet_weapon_far_red": {
        "minecraft:shooter": {
          "def": "coldsink:legion_ai_bullet_red<bullet_weapon_far>"
        }
      },
      // 强火子弹-近程
      "bullet_power_near_blue": {
