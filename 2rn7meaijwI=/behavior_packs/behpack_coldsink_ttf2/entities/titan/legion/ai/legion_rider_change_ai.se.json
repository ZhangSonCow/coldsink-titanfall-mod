{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "coldsink:legion_rider_change_ai",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "ctrl.titan_ai_rider_target": "controller.animation.titan_ai_rider_target.func"
      },
      "scripts": {
        "animate": [
          "ctrl.titan_ai_rider_target"
        ]
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "tool", "ai_rider_tool" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 1,
        "width": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      // 根据是否有敌人切换军团模式
      "minecraft:target_nearby_sensor": {
        "inside_range": 32,
        "on_inside_range": {
          "event": "turn_titan_change_mode",
          "target": "self"
        },
        "outside_range": 32,
        "on_outside_range": {
          "event": "turn_titan_change_mode",
          "target": "self"
        }
      },
      "minecraft:follow_range": {
        "value": 512,
        "max": 512
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "is_amphibious": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:fire_immune": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "all_of": [
                {
                  "test": "is_riding",
                  "subject": "self",
                  "operator": "!="
                }
              ]
            }
          ]
        }
      },
      // 索敌
      "minecraft:behavior.nearest_prioritized_attackable_target": {
        "priority": 1,
        "within_radius": 32,
        "reselect_targets": true,
        "must_see": false,
        "must_see_forget_duration": 1.0,
        "entity_types": [
          // 玩家与泰坦
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_blue"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_blue"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "has_tag",
                          "subject": "self",
                          "value": "team_red"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "operator": "!=",
                          "value": "team_red"
                        }
                      ]
                    }
                  ]
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "titan_staic"
                }
              ]
            },
            "max_dist": 512,
            "priority": 1
          },
          // 怪物
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 512,
            "priority": 2
          }
        ]
      }
    },


    "component_groups": {
        
      "die": {
        "minecraft:instant_despawn": {}
      }

    },

    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "tag @s add team_blue"
          ]
        }
      },
      // 自动泰坦无技能
      "no_random_skill": {
        "remove": {
          "component_groups": [
            "random_skill"
          ]
        }
      },
      // 队伍
      "team_blue":{
        "queue_command": {
          "command": [
            "tag @s add team_blue",
            "tag @s remove team_red"
          ]
        }
      },
      "team_red":{
        "queue_command": {
          "command": [
            "tag @s add team_red",
            "tag @s remove team_blue"
          ]
        }
      },
      // 军团模式切换
      "turn_titan_change_mode": {
        "queue_command": {
          "command": [
            "execute @e[family=legion_titan,r=8,c=1] ~~~ execute @s[tag=!in_core] ~~~ event entity @e[type=coldsink:legion_rider_ai,r=8,c=1] turn_rider_state_change"
          ]
        }
      },
      "godie": {
        "add": {
          "component_groups": [
            "die"
          ]
        }
      }
    }
  }
}
