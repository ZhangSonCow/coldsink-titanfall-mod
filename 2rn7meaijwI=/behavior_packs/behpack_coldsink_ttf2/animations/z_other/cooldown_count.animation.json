{
  "format_version": "1.8.0",
  "animations": {

    "animation.cooldown_count_0.func": {
      "loop": true,
      "animation_length": 1.0,
      "timeline": {
        "0.0": [
          "/event entity @s[tag=!is_scorch] remove_cooldown_0_1"
        ]
      }
    },

    "animation.cooldown_count_1.func": {
      "loop": true,
      "animation_length": 1.0,
      "timeline": {
        "0.0": [
          "/event entity @s[tag=!monarch_core_31] remove_cooldown_1_1"
        ]
      }
    },

    "animation.cooldown_count_2.func": {
      "loop": true,
      "animation_length": 1.0,
      "timeline": {
        "0.0": [
          "/event entity @s remove_cooldown_2_1"
        ]
      }
    },

    "animation.cooldown_count_sp.func": {
      "loop": false,
      "animation_length": 10.0,
      "timeline": {
        "1.5": [
          "/event entity @s set_charge_sp_0",
          "/event entity @s[scores={elesmoke_number=1}] set_charge_sp_1",
          "/event entity @s[scores={elesmoke_number=2}] set_charge_sp_2",
          "/event entity @s[scores={elesmoke_number=3}] set_charge_sp_3",
          "/event entity @s[scores={elesmoke_number=4}] set_charge_sp_4",
          "/event entity @s[scores={elesmoke_number=5..}] set_charge_sp_5"
        ]
      }
    }

  }
}
