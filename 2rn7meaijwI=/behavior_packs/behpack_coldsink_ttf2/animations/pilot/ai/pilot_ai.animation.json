          "/tag @s remove pilot_melee_self",

          "/execute @s[tag=team_blue,tag=!dead] ^^3^ damage @e[tag=!team_blue,family=!titan,family=!tool,type=!item,type=!xp_orb,r=5] 20 suicide entity @s",
