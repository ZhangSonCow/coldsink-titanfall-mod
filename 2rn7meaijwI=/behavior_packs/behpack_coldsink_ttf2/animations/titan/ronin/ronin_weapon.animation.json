{
  "format_version": "1.8.0",
  "animations": {
    "animation.ronin_fire.func": {
      "loop": true,
      "animation_length": 0.42,
      "timeline": {
        "0.0": [
          "/event entity @s[scores={ronin_bullet=1..},tag=team_blue,tag=!ronin_phase] ronin_fire_blue",
          "/event entity @s[scores={ronin_bullet=1..},tag=team_red,tag=!ronin_phase] ronin_fire_red",
          "/event entity @s[scores={ronin_bullet=1..}] ronin_fire"
        ],
        "0.3": [
          "/event entity @s[scores={ronin_bullet=..0}] set_action_0",
          "/event entity @s[tag=!weapon_fire] set_action_0"
        ]
      }
    },
    "animation.ronin_reload.func": {
      "loop": false,
      "animation_length": 10.0,
      "timeline": {
        "0.1": [
          "/camerashake add @s 0.15 0.4 rotational"
        ],
        "1.3": [
          "/camerashake add @s 0.3 0.3 rotational"
        ],
        "2.5": [
          "/event entity @s set_action_0",
          "/scoreboard players set @s[tag=is_titan] ronin_bullet 4",
          "/event entity @s[tag=is_titan] set_weapon_4"
        ]
      }
    }
  }
}
