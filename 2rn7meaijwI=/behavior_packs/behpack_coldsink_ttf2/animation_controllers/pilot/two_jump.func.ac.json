{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.two_jump.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "two_jump": "q.is_jumping"
            }
          ]
        },
        "two_jump": {
          "transitions": [
            {
              "default": "!q.is_jumping"
            }
          ],
          "on_entry": [
            "/tag @s[tag=pre_jump,tag=!jump_over] add two_jump_self",
            "/execute @s[tag=pre_jump,tag=!jump_over,tag=!sliding_jump] ~~~ summon coldsink:two_jump_tool",
            "/tag @s[tag=pre_jump,tag=!jump_over,tag=sliding_jump] add sliding_two_jump_self",
            "/execute @s[tag=pre_jump,tag=!jump_over,tag=sliding_jump] ~~~ summon coldsink:sliding_two_jump_tool ^^^-1",
            "/event entity @s[tag=!pre_jump] set_action_51",
            "/event entity @s[tag=pre_jump,tag=!jump_over] set_action_52",
            "/tag @s[tag=pre_jump,tag=!jump_over] add jump_over",
            "/tag @s add pre_jump"
          ]
        }
      }
    }
  }
}