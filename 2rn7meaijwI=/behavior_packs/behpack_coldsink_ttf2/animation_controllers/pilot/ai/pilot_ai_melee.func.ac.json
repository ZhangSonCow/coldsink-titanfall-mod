{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pilot_ai_melee.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "melee": "q.property('titan:other_action') == 3 && q.property('pilot:rodeo_status') == 0"
            }
          ]
        },
        "melee": {
          "animations": [
            "pilot_ai_melee"
          ],
          "transitions": [
            {
              "default": "q.property('titan:other_action') != 3"
            }
          ]
        }
      }
    }
  }
}