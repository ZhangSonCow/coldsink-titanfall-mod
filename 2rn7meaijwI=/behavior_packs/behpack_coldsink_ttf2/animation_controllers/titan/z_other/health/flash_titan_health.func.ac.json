{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.flash_titan_health.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "flash": "q.is_ignited"
            }
          ]
        },
        "flash": {
          "animations": [ "flash_titan_health" ],
          "transitions": [
            {
              "default": "!q.is_ignited"
            }
          ]
        }
      }
    }
  }
}