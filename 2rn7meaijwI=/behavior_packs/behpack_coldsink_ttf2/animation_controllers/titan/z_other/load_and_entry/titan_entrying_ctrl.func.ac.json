{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.titan_entrying_ctrl.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "entrying": "q.property('titan:action') >= 100"
            }
          ],
          "on_entry": [
            "/tag @s remove titan_camera"
          ],
          "on_exit": [
            "/tag @s add titan_camera"
          ]
        },
        "entrying": {
          "transitions": [
            {
              "default": "q.property('titan:action') < 100"
            }
          ]
        }
      }
    }
  }
}