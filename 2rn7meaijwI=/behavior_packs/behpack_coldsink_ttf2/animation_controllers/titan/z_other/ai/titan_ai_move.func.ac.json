{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.titan_ai_move.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "spurt": "!q.ground_speed > 1"
            }
          ]
        },
        "spurt": {
          "animations": [ "titan_ai_move_damage" ],
          "transitions": [
            {
              "default": "q.ground_speed <= 1"
            }
          ],
          "on_entry": [
            "/tag @s add is_moving"
          ],
          "on_exit": [
            "/tag @s remove is_moving"
          ]
        }
      }
    }
  }
}