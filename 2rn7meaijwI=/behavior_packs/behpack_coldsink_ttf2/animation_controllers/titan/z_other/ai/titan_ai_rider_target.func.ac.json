{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.titan_ai_rider_target.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "has_target": "q.has_target"
            }
          ]
        },
        "has_target": {
          "transitions": [
            {
              "default": "!q.has_target"
            }
          ],
          "on_entry": [
            "/event entity @s turn_rider_state_aim",
            "/tag @s add has_target",
            "/tag @e[family=titan,r=8,c=1] add has_target"
          ],
          "on_exit": [
            "/event entity @s turn_rider_state_normal",
            "/tag @s remove has_target",
            "/tag @e[family=titan,r=8,c=1] remove has_target"
          ]
        }
      }
    }
  }
}