{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.titan_player_move.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "idle_move": "!q.property('titan:weapon_aim') && q.is_stunned && ( q.property('titan:action') < 2 || q.property('titan:action') == 4 || (q.variant == 6 && q.property('titan:action') == 12) && !q.is_saddled )"
            },
            {
              "spurt": "q.out_of_control"
            }
          ]
        },
        "idle_move": {
          "transitions": [
            {
              "default": "q.property('titan:weapon_aim') || !q.is_stunned || ( q.property('titan:action') > 1 && q.property('titan:action') != 4 && !(q.variant == 6 && q.property('titan:action') == 12) && !q.is_saddled )"
            },
            {
              "idle_run": "q.is_sprinting"
            },
            {
              "spurt": "q.out_of_control"
            }
          ],
          "on_entry": [
            "/tag @s add titan_moving"
          ],
          "on_exit": [
            "/tag @s remove titan_moving"
          ]
        },
        "idle_run": {
          "transitions": [
            {
              "default": "!q.is_sprinting"
            },
            {
              "spurt": "q.out_of_control"
            }
          ],
          "on_entry": [
            "/effect @e[family=titan_ride,r=8,c=1] slowness 99999 0 true",
            "/tag @s add titan_running"
          ],
          "on_exit": [
            "/effect @e[family=titan_ride,r=8,c=1] slowness 0 1 true",
            "/tag @s remove titan_running"
          ]
        },
        "spurt": {
          "animations": [
            "titan_spurt_slide"
          ],
          "transitions": [
            {
              "default": "!q.out_of_control"
            }
          ]
        }
      }
    }
  }
}