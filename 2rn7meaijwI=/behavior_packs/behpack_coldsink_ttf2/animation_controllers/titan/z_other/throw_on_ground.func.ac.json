{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.throw_on_ground.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "self"
          ],
          "transitions": [
            {
              "down": "q.is_on_ground"
            }
          ]
        },
        "down": {
          "on_entry": [
            "/event entity @s beOnGround"
          ]
        }
      }
    }
  }
}