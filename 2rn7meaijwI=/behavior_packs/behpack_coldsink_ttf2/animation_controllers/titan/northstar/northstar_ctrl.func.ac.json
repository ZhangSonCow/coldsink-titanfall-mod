{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.northstar_ctrl.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "reload": "q.property('titan:weapon_value') == 0 || (v.attack_time && !q.property('titan:weapon_aim') && q.property('titan:weapon_value') < 6 && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_weapon'))"
            },
            {
              "melee": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_melee')"
            },
            {
              "powering": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_weapon') && q.property('titan:weapon_value') > 0"
            },
            {
              "missile": "q.property('titan:skill_cooldown_1') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_skill_1')"
            },
            {
              "core": "q.property('titan:core_value') == 100 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_skill_3')"
            }
          ],
          "on_entry": [
            "/event entity @s[tag=titan_idle,tag=!titan_reload,tag=!terminate] set_action_0"
          ]
        },
        "fire": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 3"
            }
          ],
          "on_entry": [
            "/event entity @s[scores={northstar_bullet=1..}] set_action_3",
            "/tag @s add keep_fire"
          ],
          "on_exit": [
            "/tag @s remove keep_fire"
          ]
        },
        "reload": {
          "transitions": [
            {
              "melee": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_melee')"
            },
            {
              "powering": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_weapon') && q.property('titan:weapon_value') > 0"
            },
            {
              "missile": "q.property('titan:skill_cooldown_1') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_skill_1')"
            },
            {
              "core": "q.property('titan:core_value') == 100 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_skill_3')"
            },
            {
              "default": "q.property('titan:action') != 4"
            }
          ],
          "on_entry": [
            "/event entity @s[scores={northstar_bullet=..5}] set_action_4"
          ]
        },
        "melee": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ],
          "on_entry": [
            "/event entity @s[tag=!terminate] set_action_5",
            "/tag @s add keep_melee"
          ],
          "on_exit": [
            "/tag @s remove keep_melee"
          ]
        },
        "powering": {
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3 || !(q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:northstar_weapon'))"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_11"
          ]
        },
        "missile": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 12"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_12",
            "/tag @s add keep_skill_q"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_q"
          ]
        },
        "core": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_13",
            "/tag @s add keep_skill_v"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_v"
          ]
        }
      }
    }
  }
}