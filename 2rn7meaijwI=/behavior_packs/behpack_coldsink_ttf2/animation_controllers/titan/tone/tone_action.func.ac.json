{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.tone_action.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3 && q.property('titan:weapon_value') > 0"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "missile_check": "q.property('titan:action') == 18"
            },
            {
              "sense": "q.property('titan:action') == 14"
            },
            {
              "core_pre": "q.property('titan:action') == 15"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_0",
            "/tag @s remove terminate",
            "/event entity @s[tag=keep_fire,scores={tone_bullet=1..}] set_action_3",
            "/event entity @s[scores={tone_bullet=..0},tag=!keep_skill_q,tag=!keep_skill_g,tag=!keep_skill_v] set_action_4",
            "/event entity @s[tag=keep_melee] set_action_5",
            "/event entity @s[tag=keep_skill_q,tag=!skill_cooldown_1] set_action_18",
            "/event entity @s[tag=keep_skill_g,tag=!skill_cooldown_2] set_action_14",
            "/event entity @s[tag=keep_skill_v,scores={titan_core=100..}] set_action_15",
            "/tag @s add titan_idle"
          ],
          "on_exit": [
            "/tag @s remove titan_idle"
          ]
        },
        "fire": {
          "animations": [
            "tone_fire"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 3 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            }
          ],
          "on_entry": [
            "/tag @s add weapon_fire",
            "/tag @s add titan_idle"
          ],
          "on_exit": [
            "/tag @s remove weapon_fire",
            "/tag @s remove titan_idle"
          ]
        },
        "reload": {
          "animations": [
            "tone_reload"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ],
          "on_entry": [
            "/tag @s[scores={tone_bullet=..11}] add tone_reload",
            "/execute @s[scores={tone_bullet=..11}] ~~~ playsound tone_reload @a[tag=!tone_reload,r=16] ~~~",
            "/playsound tone_reload.self @s[scores={tone_bullet=..11}]",
            "/tag @s[scores={tone_bullet=..11}] remove tone_reload",
            "/tag @s add titan_idle",
            "/tag @s add titan_reload"
          ],
          "on_exit": [
            "/tag @s remove titan_idle",
            "/stopsound @a[r=32] tone_reload",
            "/stopsound @s tone_reload.self",
            "/tag @s remove titan_reload"
          ]
        },
        "melee": {
          "animations": [
            "tone_melee"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "missile_check": {
          "animations": [
            "tone_skill_1_check"
          ],
          "transitions": [
            {
              "missile_pre": "q.property('titan:action') == 11"
            },
            {
              "default": "q.property('titan:action') == 0"
            }
          ],
          "on_entry": [
            "/tag @e[type=coldsink:tone_titan,c=1] add trace_missile_self",
            "/tag @s add trace_missile_self",
            "/scoreboard players set @s tone_missile 0",
            "/execute @s[tag=team_blue] ~~~ execute @e[tag=!trace_missile_self,scores={tone_target=3..},tag=!team_blue,r=80] ~~~ scoreboard players add @p[tag=trace_missile_self,tag=team_blue] tone_missile 1",
            "/execute @s[tag=team_red] ~~~ execute @e[tag=!trace_missile_self,scores={tone_target=3..},tag=!team_red,r=80] ~~~ scoreboard players add @p[tag=trace_missile_self,tag=team_red] tone_missile 1",
            "/title @s[scores={tone_missile=0}] actionbar §c无锁定目标",
            "/event entity @s[scores={tone_missile=0}] set_action_0",
            "/scoreboard players operation @s[scores={tone_missile=1..}] tone_missile_st = @s tone_missile",
            "/scoreboard players operation @s[scores={tone_missile=1..}] tone_trace_self = count tone_trace",
            "/tag @e[tag=trace_missile_self] remove trace_missile_self",
            "/tag @s remove keep_skill_q"
          ]
        },
        "missile_pre": {
          "animations": [
            "tone_skill_1_pre"
          ],
          "transitions": [
            {
              "missile": "q.property('titan:action') == 12"
            },
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "missile": {
          "animations": [
            "tone_skill_1"
          ],
          "transitions": [
            {
              "missile_after": "q.property('titan:action') == 13"
            },
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "missile_after": {
          "animations": [
            "tone_skill_1_after"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_13"
          ],
          "on_exit": [
            "/event entity @s set_cooldown_1_2"
          ]
        },
        "sense": {
          "animations": [
            "tone_skill_2"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 14"
            }
          ],
          "on_entry": [
            "/tag @s remove keep_skill_g"
          ]
        },
        "core_pre": {
          "animations": [
            "tone_skill_3_pre"
          ],
          "transitions": [
            {
              "core": "q.property('titan:action') != 15"
            }
          ],
          "on_entry": [
            "/tag @s add core_self",
            "/playsound tone_core_begin @a[r=64] ~~~",
            "/playsound tone_core_begin.self @s",
            "/tag @s remove core_self",

            "/tag @s remove titan_core_saied",
            "/event entity @s add_titan_sheared",
            "/scoreboard players set @e[type=coldsink:tone_titan,c=1] titan_core 0",
            "/scoreboard players set @s[scores={titan_core=101..}] titan_core 100",
            "/tag @s add in_core",
            "/tag @s remove keep_skill_v"
          ]
        },
        "core": {
          "animations": [
            "tone_skill_3",
            "tone_skill_3_timer"
          ],
          "transitions": [
            {
              "core_after": "q.property('titan:action') != 16"
            }
          ],
          "on_entry": [
            "/event entity @s tone_core_trigger"
          ],
          "on_exit": [
            "/event entity @s clear_titan_sheared",
            "/tag @s remove in_core",
            "/playsound tone_core_end @s",
            "/tag @s remove titan_elesmoke_saied"
          ]
        },
        "core_after": {
          "animations": [
            "tone_skill_3_after"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 17"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_17"
          ]
        }
      }
    }
  }
}