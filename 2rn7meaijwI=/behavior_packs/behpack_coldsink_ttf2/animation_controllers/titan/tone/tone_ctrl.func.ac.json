{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.tone_ctrl.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_weapon') && q.property('titan:weapon_value') > 0"
            },
            {
              "reload": "v.attack_time && !q.property('titan:weapon_aim') && q.property('titan:weapon_value') < 12 && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_weapon')"
            },
            {
              "melee": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_melee')"
            },
            {
              "missile_check": "q.property('titan:skill_cooldown_1') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_1')"
            },
            {
              "sense": "q.property('titan:skill_cooldown_2') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_2')"
            },
            {
              "core_pre": "q.property('titan:core_value') == 100 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_3')"
            }
          ],
          "on_entry": [
            "/event entity @s[tag=titan_idle,tag=!titan_reload,tag=!terminate] set_action_0"
          ]
        },
        "fire": {
          "transitions": [
            {
              "default": "!q.is_using_item"
            }
          ],
          "on_entry": [
            "/event entity @s[scores={tone_bullet=1..}] set_action_3",
            "/tag @s add keep_fire"
          ],
          "on_exit": [
            "/event entity @s[tag=!titan_reload] set_action_0",
            "/tag @s remove keep_fire"
          ]
        },
        "reload": {
          "transitions": [
            {
              "fire": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_weapon') && q.property('titan:weapon_value') > 0"
            },
            {
              "melee": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_melee')"
            },
            {
              "missile_check": "q.property('titan:skill_cooldown_1') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_1')"
            },
            {
              "sense": "q.property('titan:skill_cooldown_2') == 0 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_2')"
            },
            {
              "core_pre": "q.property('titan:core_value') == 100 && q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'coldsink:tone_skill_3')"
            },
            {
              "default": "q.property('titan:action') != 4"
            }
          ],
          "on_entry": [
            "/event entity @s[scores={tone_bullet=..11}] set_action_4"
          ]
        },
        "melee": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ],
          "on_entry": [
            "/event entity @s[tag=!terminate] set_action_5",
            "/tag @s add keep_melee"
          ],
          "on_exit": [
            "/tag @s remove keep_melee"
          ]
        },
        "missile_check": {
          "transitions": [
            {
              "missile_pre": "q.property('titan:action') == 11"
            },
            {
              "default": "q.property('titan:action') == 0 && !q.is_using_item"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_18",
            "/tag @s add keep_skill_q"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_q"
          ]
        },
        "missile_pre": {
          "transitions": [
            {
              "missile": "q.property('titan:action') == 12"
            },
            {
              "default": "q.property('titan:action') == 0"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_11"
          ]
        },
        "missile": {
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "missile_after": "q.property('titan:action') == 13"
            }
          ]
        },
        "missile_after": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "sense": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 14"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_14",
            "/tag @s add keep_skill_g"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_g"
          ]
        },
        "core_pre": {
          "transitions": [
            {
              "core": "q.property('titan:action') != 15"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_15",
            "/tag @s add keep_skill_v"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_v"
          ]
        },
        "core": {
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "core_after": "q.property('titan:action') == 17"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_16"
          ]
        },
        "core_after": {
          "transitions": [
            {
              "default": "q.property('titan:action') != 17"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_17"
          ]
        }
      }
    }
  }
}