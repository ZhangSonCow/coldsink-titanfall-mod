{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ion_action.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3 && q.property('titan:weapon_value') > 0 && !( q.property('titan:weapon_aim') && q.property('titan:skill_cooldown_0') > 189 )"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "laser_pre": "q.property('titan:action') == 11"
            },
            {
              "shield_pre": "q.property('titan:action') == 14"
            },
            {
              "core_pre": "q.property('titan:action') == 18"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_0",
            "/tag @s remove terminate",
            "/event entity @s[tag=keep_fire,scores={ion_bullet=1..}] set_action_3",
            "/event entity @s[scores={ion_bullet=..0},tag=!keep_skill_mid,tag=!keep_skill_q,tag=!keep_skill_v] set_action_4",
            "/event entity @s[tag=keep_melee] set_action_5",
            "/event entity @s[tag=keep_skill_mid,tag=!skill_cooldown_0] set_action_14",
            "/event entity @s[tag=keep_skill_q,tag=!skill_cooldown_1] set_action_11",
            "/event entity @s[tag=keep_skill_v,scores={titan_core=100..}] set_action_18",
            "/tag @s add titan_idle"
          ],
          "on_exit": [
            "/tag @s remove titan_idle"
          ]
        },
        "fire": {
          "animations": [
            "ion_fire"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 3 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0) || ( q.property('titan:weapon_aim') && q.property('titan:skill_cooldown_0') > 189 )"
            }
          ],
          "on_entry": [
            "/tag @s add weapon_fire",
            "/tag @s add titan_idle"
          ],
          "on_exit": [
            "/tag @s remove weapon_fire",
            "/tag @s remove titan_idle"
          ]
        },
        "reload": {
          "animations": [
            "ion_reload"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ],
          "on_entry": [
            "/tag @s[scores={ion_bullet=..39}] add ion_reload",
            "/execute @s[scores={ion_bullet=..39}] ~~~ playsound ion_reload @a[tag=!ion_reload,r=16] ~~~",
            "/playsound ion_reload.self @s[scores={ion_bullet=..39}]",
            "/tag @s[scores={ion_bullet=..39}] remove ion_reload",
            "/tag @s add titan_idle",
            "/tag @s add titan_reload"
          ],
          "on_exit": [
            "/tag @s remove titan_idle",
            "/stopsound @a[r=32] ion_reload",
            "/stopsound @s ion_reload.self",
            "/tag @s remove titan_reload"
          ]
        },
        "melee": {
          "animations": [
            "ion_melee"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ],
          "on_entry": [
            "/tag @s add titan_melee"
          ],
          "on_exit": [
            "/tag @s remove titan_melee"
          ]
        },
        "laser_pre": {
          "animations": [
            "ion_skill_1_pre"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "laser": "q.property('titan:action') == 12"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "laser": {
          "animations": [
            "ion_skill_1"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "laser_after": "q.property('titan:action') == 13"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ],
          "on_entry": [
            "/tag @s add laser_ready",
            // 点按瞬发
            "/event entity @s[tag=!keep_skill_q] set_action_13"
          ],
          "on_exit": [
            "/tag @s remove laser_ready",
            "/stopsound @s ion_skill_1_powering.self",
            "/tag @s remove keep_skill_q"
          ]
        },
        "laser_after": {
          "animations": [
            "ion_skill_1_after"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_13",
            "/event entity @s ion_skill_1",
            "/event entity @s add_cooldown_0_110"
          ],
          "on_exit": [
            "/event entity @s set_cooldown_1_2"
          ]
        },
        "shield_pre": {
          "animations": [
            "ion_skill_0_pre"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield": "q.property('titan:action') == 15"
            }
          ]
        },
        "shield": {
          "animations": [
            "ion_skill_0",
            "ion_skill_0_timer"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield_check": "q.property('titan:action') == 20 || q.property('titan:skill_cooldown_0') > 188"
            }
          ],
          "on_entry": [
            "/tag @s add shield_ready",
            "/tag @e[type=coldsink:ion_titan,tag=!energy_shield,r=8,c=1] add energy_shield",
            "/playsound ion_skill_0 @s",
            // 点按瞬发
            "/event entity @s[tag=!keep_skill_mid] set_action_20"
          ],
          "on_exit": [
            "/tag @s remove shield_ready",
            "/execute @s[tag=team_blue] ^^^5 tp @e[type=coldsink:ion_get_bullet_blue,r=12] ^^^5",
            "/execute @s[tag=team_blue] ^^^3 event entity @e[type=coldsink:ion_get_bullet_blue,r=8] back",
            "/execute @s[tag=team_blue] ^^^5 tp @e[type=coldsink:ion_get_missile_blue,r=12] ^^^5",
            "/execute @s[tag=team_blue] ^^^3 event entity @e[type=coldsink:ion_get_missile_blue,r=8] back",
            "/execute @s[tag=team_red] ^^^5 tp @e[type=coldsink:ion_get_bullet_red,r=12] ^^^5",
            "/execute @s[tag=team_red] ^^^3 event entity @e[type=coldsink:ion_get_bullet_red,r=8] back",
            "/execute @s[tag=team_red] ^^^5 tp @e[type=coldsink:ion_get_missile_red,r=12] ^^^5",
            "/execute @s[tag=team_red] ^^^3 event entity @e[type=coldsink:ion_get_missile_red,r=8] back",
            "/tag @e[type=coldsink:ion_titan,tag=energy_shield,r=8,c=1] remove energy_shield",
            "/stopsound @s ion_skill_0"
          ]
        },
        "shield_check": {
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield_back": "q.property('titan:action') == 17"
            },
            {
              "shield_after": "q.property('titan:action') == 16"
            }
          ],
          "on_entry": [
            "/event entity @s[tag=ion_get_bullet] set_action_17",
            "/event entity @s[tag=!ion_get_bullet] set_action_16",
            "/tag @s remove ion_get_bullet"
          ],
          "on_exit": [
            "/tag @s remove keep_skill_mid"
          ]
        },
        "shield_after": {
          "animations": [
            "ion_skill_0_after"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 16"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_16"
          ]
        },
        "shield_back": {
          "animations": [
            "ion_skill_0_back"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 17"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_17"
          ]
        },
        "core_pre": {
          "animations": [
            "ion_skill_3_pre"
          ],
          "transitions": [
            {
              "core": "q.property('titan:action') != 18"
            }
          ],
          "on_entry": [
            "/tag @s add core_self",
            "/playsound ion_core_begin @a[r=64] ~~~",
            "/playsound ion_core_begin.self @s",
            "/tag @s remove core_self",
            "/tag @s remove titan_core_saied",
            "/event entity @s add_titan_sheared",
            "/scoreboard players set @e[type=coldsink:ion_titan,c=1] titan_core 0",
            "/effect @e[type=coldsink:ion_ride,c=1] slowness 6 2 true",
            "/tag @s add in_core",
            "/tag @s remove keep_skill_v"
          ]
        },
        "core": {
          "animations": [
            "ion_skill_3"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 19"
            }
          ],
          "on_exit": [
            "/playsound ion_core_end @s",
            "/tag @s remove titan_core_saied",
            "/event entity @s clear_titan_sheared",
            "/effect @e[type=coldsink:ion_ride,c=1] slowness 6 2 true",
            "/tag @s remove in_core"
          ]
        }
      }
    }
  }
}