{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scorch_action.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3 && q.property('titan:weapon_value') > 0"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "firewall": "q.property('titan:action') == 11"
            },
            {
              "shield_pre": "q.property('titan:action') == 12"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_0",
            "/tag @s remove terminate",
            "/event entity @s[tag=keep_fire,scores={scorch_bullet=1..}] set_action_3",
            "/event entity @s[scores={scorch_bullet=..0},tag=!keep_skill_mid,tag=!keep_skill_q,tag=!keep_skill_v] set_action_4",
            "/event entity @s[tag=keep_melee] set_action_5",
            "/event entity @s[tag=keep_skill_mid,tag=!skill_cooldown_0] set_action_12",
            "/event entity @s[tag=keep_skill_q,tag=!skill_cooldown_1] set_action_11",
            "/event entity @s[tag=keep_skill_v,scores={titan_core=100..}] set_action_15",
            "/tag @s add titan_idle"
          ],
          "on_exit": [
            "/tag @s remove titan_idle"
          ]
        },
        "fire": {
          "animations": [
            "scorch_fire"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 3 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            }
          ]
        },
        "reload": {
          "animations": [
            "scorch_reload"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ],
          "on_entry": [
            "/tag @s[scores={scorch_bullet=..0}] add scorch_reload",
            "/execute @s[scores={scorch_bullet=..0}] ~~~ playsound scorch_reload @a[tag=!scorch_reload,r=16] ~~~",
            "/playsound scorch_reload.self @s[scores={scorch_bullet=..0}]",
            "/tag @s[scores={scorch_bullet=..0}] remove scorch_reload",
            "/tag @s add titan_idle",
            "/tag @s add titan_reload"
          ],
          "on_exit": [
            "/tag @s remove titan_idle",
            "/stopsound @a[r=32] scorch_reload",
            "/stopsound @s scorch_reload.self",
            "/tag @s remove titan_reload"
          ]
        },
        "melee": {
          "animations": [
            "scorch_melee"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "firewall": {
          "animations": [
            "scorch_skill_1"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 11"
            }
          ],
          "on_entry": [
            "/tag @s remove keep_skill_q"
          ]
        },
        "shield_pre": {
          "animations": [
            "scorch_skill_0_pre"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield": "q.property('titan:action') == 13"
            }
          ]
        },
        "shield": {
          "animations": [
            "scorch_skill_0"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield_after": "q.property('titan:action') == 14 || q.property('titan:skill_cooldown_0') >= 40"
            }
          ],
          "on_entry": [
            "/tag @s add shield_ready",
            "/tag @e[type=coldsink:scorch_titan,tag=!energy_shield,r=8,c=1] add energy_shield",
            "/tag @s add scorch_self",
            "/execute @s ~~~ playsound scorch_skill_0 @a[tag=!scorch_self,r=32] ~~~",
            "/playsound scorch_skill_0.self @s",
            "/tag @s remove scorch_self",
            // 点按瞬发
            "/event entity @s[tag=!keep_skill_mid] set_action_14"
          ],
          "on_exit": [
            "/tag @s remove shield_ready",
            "/tag @e[type=coldsink:scorch_titan,tag=energy_shield,r=8,c=1] remove energy_shield",
            "/tag @s add scorch_self",
            "/stopsound @a[tag=!scorch_self,r=32] scorch_skill_0",
            "/stopsound @s scorch_skill_0.self",
            "/tag @s remove scorch_self",
            "/tag @s remove keep_skill_mid"
          ]
        },
        "shield_after": {
          "animations": [
            "scorch_skill_0_after"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 14"
            }
          ],
          "on_entry": [
            "/event entity @s set_action_14"
          ]
        },
        "core": {
          "animations": [
            "scorch_skill_3"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 15"
            }
          ],
          "on_entry": [
            "/tag @s add core_self",
            "/playsound scorch_core_begin @a[r=64] ~~~",
            "/playsound scorch_core_begin.self @s",
            "/tag @s remove core_self",

            "/tag @s remove titan_core_saied",
            "/effect @e[type=coldsink:scorch_ride,c=1] slowness 3 100 true",
            "/event entity @s add_titan_sheared",
            "/scoreboard players set @e[type=coldsink:scorch_titan,c=1] titan_core 0",
            "/scoreboard players set @s[scores={titan_core=100..}] titan_core 0",
            "/tag @s add in_core",
            "/tag @s remove keep_skill_v"
          ],
          "on_exit": [
            "/event entity @s clear_titan_sheared",
            "/tag @s remove in_core",
            "/tag @s remove titan_elesmoke_saied"
          ]
        }
      }
    }
  }
}