{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scorch_titan_ai_action.func": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "melee": "q.property('titan:action') == 11"
            },
            {
              "fire": "q.property('titan:action') == 12"
            },
            {
              "firewall": "q.property('titan:action') == 13"
            },
            {
              "core": "q.property('titan:action') == 14"
            },
            {
              "shield": "q.property('titan:action') == 15"
            }
          ],
          "on_entry": [
            "/execute @s[tag=team_blue] ~~~ event entity @e[type=coldsink:scorch_rider_ai,tag=team_blue,r=8,c=1] turn_rider_state_normal",
            "/execute @s[tag=team_red] ~~~ event entity @e[type=coldsink:scorch_rider_ai,tag=team_red,r=8,c=1] turn_rider_state_normal"
          ]
        },
        "melee": {
          "animations": [
            "scorch_ai_melee"
          ],
          "transitions": [
            {
              "core": "q.property('titan:action') == 14"
            },
            {
              "default": "q.property('titan:action') != 11"
            }
          ]
        },
        "fire": {
          "transitions": [
            {
              "core": "q.property('titan:action') == 14"
            },
            {
              "default": "q.property('titan:action') != 12"
            }
          ]
        },
        "firewall": {
          "animations": [
            "scorch_ai_firewall"
          ],
          "transitions": [
            {
              "core": "q.property('titan:action') == 14"
            },
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "core": {
          "animations": [
            "scorch_ai_core"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ],
          "on_entry": [
            "/playsound scorch_core_begin @a[r=64] ~~~",
            "/playsound scorch_skill_3 @a[r=64] ~~~",
            "/tag @s add no_spurt",
            "/ride @e[type=coldsink:scorch_rider_ai,r=8,c=1] stop_riding"
          ],
          "on_exit": [
            "/tag @s remove no_spurt",
            "/ride @s summon_rider coldsink:scorch_rider_ai"
          ]
        },
        "shield": {
          "animations": [
            "scorch_ai_shield",
            "scorch_ai_shield_timer"
          ],
          "transitions": [
            {
              "core": "q.property('titan:action') == 14"
            },
            {
              "default": "q.property('titan:action') != 15"
            }
          ],
          "on_entry": [
            "/tag @s add energy_shield",
            "/playsound scorch_skill_0 @a[r=64] ~~~"
          ],
          "on_exit": [
            "/tag @s remove energy_shield",
            "/stopsound @a[r=32] scorch_skill_0"
          ]
        }
      }
    }
  }
}