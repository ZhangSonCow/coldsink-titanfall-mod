{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.scorch_titan": {
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.scorch_titan",
            "Texture.scorch_titan_1",
            "Texture.scorch_titan_2",
            "Texture.scorch_titan_3",
            "Texture.scorch_titan_4",
            "Texture.scorch_titan_5",
            "Texture.scorch_titan_6",
            "Texture.scorch_titan_7",
            "Texture.scorch_titan_8"
          ]
        }
      },
      "geometry": "geometry.scorch_titan",
      "materials": [
        {
          "*": "material.netease_entity_metallic"
        }
      ],
      "textures": [ "Array.skin[ query.skin_id ]" ],
      "overlay_color": {
        "r": 0.1,
        "g": 0.1,
        "b": 0.1,
        "a": "q.property('titan:titan_danger') ? 0.9 : ((q.property('titan:titan_health') / 40) > 0.25 ? ((q.property('titan:titan_health') / 40) > 0.5 ? ((q.property('titan:titan_health') / 40) > 0.75 ? 0.7 : 0.5) : 0.3) : 0)"
      },
      "is_hurt_color": {}
    }
  }
}