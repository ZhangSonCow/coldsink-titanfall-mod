{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.tone_titan_ai": {
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.tone_titan",
            "Texture.tone_titan_1",
            "Texture.tone_titan_2",
            "Texture.tone_titan_3",
            "Texture.tone_titan_4",
            "Texture.tone_titan_5",
            "Texture.tone_titan_6",
            "Texture.tone_titan_7",
            "Texture.tone_titan_8"
          ]
        }
      },
      "geometry": "geometry.tone_titan",
      "materials": [
        {
          "*": "material.netease_entity_metallic"
        }
      ],
      "textures": [ "Array.skin[ query.skin_id ]" ],
      "overlay_color": {
        "r": 0.1,
        "g": 0.1,
        "b": 0.1,
        "a": "q.health <= 2500 ? 0.9 : ((1 - q.health / q.max_health) > 0.25 ? ((1 - q.health / q.max_health) > 0.5 ? ((1 - q.health / q.max_health) > 0.75 ? 0.7 : 0.5) : 0.3) : 0)"
      },
      "is_hurt_color": {
        "r": 0.1,
        "g": 0.1,
        "b": 0.1,
        "a": "q.health <= 2500 ? 0.9 : ((1 - q.health / q.max_health) > 0.25 ? ((1 - q.health / q.max_health) > 0.5 ? ((1 - q.health / q.max_health) > 0.75 ? 0.7 : 0.5) : 0.3) : 0)"
      }
    }
  }
}