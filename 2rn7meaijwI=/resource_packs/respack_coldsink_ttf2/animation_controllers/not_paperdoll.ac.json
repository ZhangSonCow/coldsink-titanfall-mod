            },
            {
              "pilot_player.back_battery_3": "q.variant == 0 && (q.is_moving || !q.is_on_ground) && v.is_pilot && q.is_item_name_any('slot.armor.legs', 0, 'coldsink:battery_overload_item') && (q.property('pilot:rodeo_status') == 0 || q.property('pilot:rodeo_status') == 2) && !v.is_first_person"
            },
