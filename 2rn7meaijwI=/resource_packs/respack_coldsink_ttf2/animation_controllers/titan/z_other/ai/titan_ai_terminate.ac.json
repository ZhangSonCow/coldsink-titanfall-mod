{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.titan_ai_terminate": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.1,
          "transitions": [
            {
              "terminate_1": "q.property('titan:action') == 98"
            },
            {
              "terminate_2": "q.property('titan:action') == 99"
            },
            {
              "by_other_terminate": "q.property('titan:action') == 10"
            }
          ]
        },
        "terminate_1": {
          "animations": [
            "terminate_1"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "terminate_2": {
          "animations": [
            "terminate_2"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "by_other_terminate": {
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        }
      }
    }
  }
}