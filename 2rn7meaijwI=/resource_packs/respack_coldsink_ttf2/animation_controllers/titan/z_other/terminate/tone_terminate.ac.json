{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.tone_terminate": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "terminate_1": "q.property('titan:action') == 126"
            },
            {
              "terminate_2": "q.property('titan:action') == 127"
            },
            {
              "by_other_terminate": "q.property('titan:action') == 128"
            }
          ]
        },
        "terminate_1": {
          "animations": [
            "tone_titan.terminate_1"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "terminate_2": {
          "animations": [
            "tone_titan.terminate_2"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "by_other_terminate": {
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        }
      }
    }
  }
}