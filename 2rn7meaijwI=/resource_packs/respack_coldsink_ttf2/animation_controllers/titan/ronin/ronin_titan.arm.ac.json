{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ronin_titan.arm": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "ronin_titan.idle.arm"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "idle_sword": "q.is_sheared"
            },
            {
              "fire": "q.property('titan:action') == 3"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "arc_pre": "q.property('titan:action') == 11"
            },
            {
              "defend_pre": "q.property('titan:action') == 14"
            },
            {
              "core_pre": "q.property('titan:action') == 17"
            },
            {
              "spurt": "q.out_of_control && q.property('titan:action') == 0"
            },
            {
              "run": "q.is_sprinting && q.property('titan:action') == 0"
            }
          ]
        },
        "idle_sword": {
          "animations": [
            "ronin_titan.idle_sword.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sheared"
            },
            {
              "melee_core_1": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 1"
            },
            {
              "melee_core_2": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 2"
            },
            {
              "melee_core_3": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 3"
            },
            {
              "arc_core_pre": "q.property('titan:action') == 11"
            },
            {
              "defend_core_pre": "q.property('titan:action') == 14"
            }
          ]
        },
        "run": {
          "animations": [
            "ronin_titan.move.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sprinting || q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "spurt": {
          "animations": [
            "ronin_titan.idle.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "fire": {
          "animations": [
            "ronin_titan.fire"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 3"
            }
          ]
        },
        "reload": {
          "animations": [
            "ronin_titan.reload"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ]
        },
        "melee": {
          "animations": [
            "ronin_titan.melee"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ]
        },
        "melee_core_1": {
          "animations": [
            "ronin_titan.melee_core_1"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0 || q.property('titan:ronin_defend') != 1"
            }
          ]
        },
        "melee_core_2": {
          "animations": [
            "ronin_titan.melee_core_2"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0 || q.property('titan:ronin_defend') != 2"
            }
          ]
        },
        "melee_core_3": {
          "animations": [
            "ronin_titan.melee_core_3"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0 || q.property('titan:ronin_defend') != 3"
            }
          ]
        },
        "arc_pre": {
          "animations": [
            "ronin_titan.arc_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "arc": "q.property('titan:action') == 12"
            }
          ]
        },
        "arc": {
          "animations": [
            "ronin_titan.arc"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "arc_after": "q.property('titan:action') == 13"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "arc_after": {
          "animations": [
            "ronin_titan.arc_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "arc_core_pre": {
          "animations": [
            "ronin_titan.arc_core_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "arc_core": "q.property('titan:action') == 12"
            }
          ]
        },
        "arc_core": {
          "animations": [
            "ronin_titan.arc_core"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "arc_core_after": "q.property('titan:action') == 13"
            },
            {
              "melee_core_1": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 1"
            },
            {
              "melee_core_2": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 2"
            },
            {
              "melee_core_3": "q.property('titan:action') == 5 && q.property('titan:ronin_defend') == 3"
            }
          ]
        },
        "arc_core_after": {
          "animations": [
            "ronin_titan.arc_core_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "defend_pre": {
          "animations": [
            "ronin_titan.defend_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "defend_1": "q.property('titan:action') == 15"
            }
          ]
        },
        "defend_1": {
          "animations": [
            "ronin_titan.defend_1"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "defend_after": "q.property('titan:action') == 16 || q.property('titan:action') == 0"
            },
            {
              "defend_2": "q.property('titan:ronin_defend') == 2"
            },
            {
              "defend_3": "q.property('titan:ronin_defend') == 3"
            }
          ]
        },
        "defend_2": {
          "animations": [
            "ronin_titan.defend_2"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "defend_after": "q.property('titan:action') == 16 || q.property('titan:action') == 0"
            },
            {
              "defend_1": "q.property('titan:ronin_defend') == 1"
            },
            {
              "defend_3": "q.property('titan:ronin_defend') == 3"
            }
          ]
        },
        "defend_3": {
          "animations": [
            "ronin_titan.defend_3"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "defend_after": "q.property('titan:action') == 16 || q.property('titan:action') == 0"
            },
            {
              "defend_1": "q.property('titan:ronin_defend') == 1"
            },
            {
              "defend_2": "q.property('titan:ronin_defend') == 2"
            }
          ]
        },
        "defend_after": {
          "animations": [
            "ronin_titan.defend_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 16"
            }
          ]
        },
        "defend_core_pre": {
          "animations": [
            "ronin_titan.defend_core_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "defend_1": "q.property('titan:action') == 15"
            }
          ]
        },
        "core_pre": {
          "animations": [
            "ronin_titan.idle_sword.arm"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "idle_sword": "q.property('titan:action') != 17"
            }
          ]
        }
      }
    }
  }
}