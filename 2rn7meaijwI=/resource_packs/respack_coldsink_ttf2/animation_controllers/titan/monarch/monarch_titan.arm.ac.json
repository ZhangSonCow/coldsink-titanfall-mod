{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.monarch_titan.arm": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "monarch_titan.idle.arm"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "fire_normal": "q.property('titan:action') == 11"
            },
            {
              "fire_arc": "q.property('titan:action') == 12"
            },
            {
              "fire_final": "q.property('titan:action') == 13"
            },
            {
              "fire_arc_final": "q.property('titan:action') == 14"
            },
            {
              "reload_fast": "q.property('titan:action') == 4 && q.property('titan:monarch_now_level') > 1 && q.property('titan:monarch_core_two') == 1"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "missile_pre": "q.property('titan:action') == 15"
            },
            {
              "reflash": "q.property('titan:action') == 18"
            },
            {
              "reflash_fast": "q.property('titan:action') == 19"
            },
            {
              "energy_pre": "q.property('titan:action') == 20"
            },
            {
              "missile_final_pre": "q.property('titan:action') == 23"
            },
            {
              "spurt": "q.out_of_control && q.property('titan:action') == 0"
            },
            {
              "run": "q.is_sprinting && q.property('titan:action') == 0"
            }
          ]
        },
        "run": {
          "animations": [
            "monarch_titan.move.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sprinting || q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "spurt": {
          "animations": [
            "monarch_titan.idle.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "fire_normal": {
          "animations": [
            "monarch_titan.fire"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload_fast": "(q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)) && q.property('titan:monarch_now_level') > 1 && q.property('titan:monarch_core_two') == 1"
            },
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 11"
            }
          ]
        },
        "fire_arc": {
          "animations": [
            "monarch_titan.fire_arc"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload_fast": "(q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)) && q.property('titan:monarch_now_level') > 1 && q.property('titan:monarch_core_two') == 1"
            },
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 12"
            }
          ]
        },
        "fire_final": {
          "animations": [
            "monarch_titan.fire_final"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload_fast": "(q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)) && q.property('titan:monarch_now_level') > 1 && q.property('titan:monarch_core_two') == 1"
            },
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "fire_arc_final": {
          "animations": [
            "monarch_titan.fire_arc_final"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload_fast": "(q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)) && q.property('titan:monarch_now_level') > 1 && q.property('titan:monarch_core_two') == 1"
            },
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 14"
            }
          ]
        },
        "reload": {
          "animations": [
            "monarch_titan.reload"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0 || q.property('titan:action') == 5 || q.property('titan:action') > 14"
            }
          ]
        },
        "reload_fast": {
          "animations": [
            "monarch_titan.reload_fast"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0 || q.property('titan:action') == 5 || q.property('titan:action') > 14"
            }
          ]
        },
        "melee": {
          "animations": [
            "monarch_titan.melee"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ]
        },
        "missile_pre": {
          "animations": [
            "monarch_titan.missile_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "missile": "q.property('titan:action') == 16"
            }
          ]
        },
        "missile": {
          "animations": [
            "monarch_titan.missile"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "missile_after": "q.property('titan:action') == 17"
            }
          ]
        },
        "missile_after": {
          "animations": [
            "monarch_titan.missile_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 17"
            }
          ]
        },
        "reflash": {
          "animations": [
            "monarch_titan.reflash"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 18"
            }
          ]
        },
        "reflash_fast": {
          "animations": [
            "monarch_titan.reflash_fast"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 19"
            }
          ]
        },
        "energy_pre": {
          "animations": [
            "monarch_titan.energy_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "energy": "q.property('titan:action') == 21"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "energy": {
          "animations": [
            "monarch_titan.energy"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "energy_after": "q.property('titan:action') == 22"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "energy_after": {
          "animations": [
            "monarch_titan.energy_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 22"
            }
          ]
        },
        "missile_final_pre": {
          "animations": [
            "monarch_titan.missile_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "missile_final_powering": "q.property('titan:action') == 24"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "missile_final_powering": {
          "animations": [
            "monarch_titan.missile_final_powering"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "missile_final": "q.property('titan:action') == 25"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "missile_final": {
          "animations": [
            "monarch_titan.missile_final"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "missile_final_after": "q.property('titan:action') == 26"
            }
          ]
        },
        "missile_final_after": {
          "animations": [
            "monarch_titan.missile_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 26"
            }
          ]
        }
      }
    }
  }
}