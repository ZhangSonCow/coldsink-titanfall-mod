{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ion_titan_1st": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "ion_titan.rotate"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3 && !( q.property('titan:weapon_aim') && q.property('titan:skill_cooldown_0') > 189 )"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "laser_pre": "q.property('titan:action') == 11"
            },
            {
              "shield_pre": "q.property('titan:action') == 14"
            },
            {
              "core_pre": "q.property('titan:action') == 18"
            },
            {
              "spurt": "q.out_of_control && q.property('titan:action') == 0"
            },
            {
              "run": "q.is_sprinting && q.property('titan:action') == 0"
            }
          ]
        },
        "run": {
          "animations": [
            "ion_titan.move.1st",
            "ion_titan.rotate"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sprinting || q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "spurt": {
          "animations": [
            "ion_titan.rotate"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "fire": {
          "animations": [
            "ion_titan.fire.1st"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "(q.property('titan:action') != 3 || ( q.property('titan:weapon_aim') && q.property('titan:skill_cooldown_0') > 189 ) ) && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ]
        },
        "reload": {
          "animations": [
            "ion_titan.reload.1st"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ]
        },
        "melee": {
          "animations": [
            "ion_titan.melee.1st"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ]
        },
        "laser_pre": {
          "animations": [
            "ion_titan.laser_pre.1st"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "laser": "q.property('titan:action') == 12"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "laser": {
          "animations": [
            "ion_titan.laser.1st"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "laser_after": "q.property('titan:action') == 13"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "laser_after": {
          "animations": [
            "ion_titan.laser_after.1st"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        },
        "shield_pre": {
          "animations": [
            "ion_titan.shield_pre.1st"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield": "q.property('titan:action') == 15"
            }
          ]
        },
        "shield": {
          "animations": [
            "ion_titan.shield.1st",
            "ion_titan.shield.particle.1st"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield_back": "q.property('titan:action') == 17"
            },
            {
              "shield_after": "q.property('titan:action') == 16"
            }
          ]
        },
        "shield_after": {
          "animations": [
            "ion_titan.shield_after.1st"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 16"
            }
          ]
        },
        "shield_back": {
          "animations": [
            "ion_titan.shield_back.1st"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 17"
            }
          ]
        },
        "core_pre": {
          "animations": [
            "ion_titan.core_pre.1st"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "core": "q.property('titan:action') != 18"
            }
          ]
        },
        "core": {
          "animations": [
            "ion_titan.core.1st"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 19"
            }
          ]
        }
      }
    }
  }
}