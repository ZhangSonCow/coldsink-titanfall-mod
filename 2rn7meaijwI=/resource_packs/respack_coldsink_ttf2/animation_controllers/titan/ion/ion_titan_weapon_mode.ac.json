{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ion_titan_weapon_mode": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.15,
          "transitions": [
            {
              "divide": "q.property('titan:weapon_aim') && q.property('titan:action') < 4"
            }
          ]
        },
        "divide": {
          "animations": [
            "ion_titan.weapon_divide",
            "ion_weapon_star.zoom"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "!q.property('titan:weapon_aim') || q.property('titan:action') > 3"
            }
          ]
        }
      }
    }
  }
}