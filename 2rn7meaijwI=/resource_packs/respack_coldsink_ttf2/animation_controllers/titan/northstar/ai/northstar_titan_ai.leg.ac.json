{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.northstar_titan_ai.leg": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "northstar_titan.idle.leg"
          ],
          "transitions": [
            {
              "walk": "q.ground_speed > 1.0 && q.ground_speed < 8.0"
            },
            {
              "flee": "q.variant == 2 && q.ground_speed > 1.0"
            },
            {
              "fly": "q.is_saddled && !q.is_on_ground"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "blend_transition": 0.5
        },
        "walk": {
          "animations": [
            "northstar_titan.walk.leg"
          ],
          "transitions": [
            {
              "run": "q.ground_speed >= 8.0 && q.out_of_control"
            },
            {
              "default": "q.ground_speed < 0.5"
            },
            {
              "flee": "q.variant == 2 && q.ground_speed > 1.0"
            },
            {
              "fly": "q.is_saddled && !q.is_on_ground"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "blend_transition": 0.5
        },
        "run": {
          "animations": [
            "northstar_titan.move.leg"
          ],
          "transitions": [
            {
              "default": "q.ground_speed < 0.5"
            },
            {
              "flee": "q.variant == 2 && q.ground_speed > 1.0"
            },
            {
              "fly": "q.is_saddled && !q.is_on_ground"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "blend_transition": 0.5
        },
        "flee": {
          "animations": [
            "northstar_titan.spurt.leg"
          ],
          "transitions": [
            {
              "default": "q.variant != 2"
            },
            {
              "fly": "q.is_saddled && !q.is_on_ground"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "blend_transition": 0.5,
          "on_entry": [
            "v.flee_degree = q.body_y_rotation;",
            "v.damagetimer = 0;"
          ]
        },
        "fly": {
          "animations": [
            "northstar_titan.fly.leg",
            "northstar_titan.fly_jet"
          ],
          "transitions": [
            {
              "default": "!q.is_saddled && q.is_on_ground"
            },
            {
              "core": "q.property('titan:action') == 15"
            }
          ],
          "blend_transition": 0.5
        },
        "core": {
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            }
          ],
          "blend_transition": 0.5
        }
      }
    }
  }
}