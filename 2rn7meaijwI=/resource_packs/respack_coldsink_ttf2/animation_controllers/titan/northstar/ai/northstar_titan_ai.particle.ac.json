{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.northstar_titan_ai.particle": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "particle": "q.property('titan:action') == 13"
            }
          ]
        },
        "particle": {
          "animations": [
            "northstar_titan.particle"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 13"
            }
          ]
        }
      }
    }
  }
}