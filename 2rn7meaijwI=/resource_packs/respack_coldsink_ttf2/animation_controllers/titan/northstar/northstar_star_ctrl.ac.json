{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.northstar_star_ctrl": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "northstar_weapon_star.staic"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "aim": "q.property('titan:action') == 11"
            }
          ]
        },
        "aim": {
          "animations": [
            "northstar_weapon_star.zoom"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') != 11"
            }
          ]
        }
      }
    }
  }
}