{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.legion_titan_ai.particle": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "particle": "q.property('titan:action') == 12 && !q.is_sheared"
            },
            {
              "particle_core": "q.property('titan:action') == 12 && q.is_sheared"
            }
          ]
        },
        "particle": {
          "animations": [
            "legion_titan.particle"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 12"
            }
          ]
        },
        "particle_core": {
          "animations": [
            "legion_titan.particle_core"
          ],
          "transitions": [
            {
              "default": "q.property('titan:action') != 12"
            }
          ]
        }
      }
    }
  }
}