{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.legion_titan.arm": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "legion_titan.idle.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "fire_after": "q.is_saddled"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "fire_pre": "q.property('titan:action') == 11"
            },
            {
              "power_pre": "q.property('titan:action') == 13"
            },
            {
              "change": "q.property('titan:action') == 16"
            },
            {
              "spurt": "q.out_of_control && q.property('titan:action') == 0"
            },
            {
              "run": "q.is_sprinting && q.property('titan:action') == 0"
            }
          ]
        },
        "run": {
          "animations": [
            "legion_titan.move.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sprinting || q.out_of_control || q.is_saddled || (q.property('titan:action') != 0 && q.property('titan:action') != 12)"
            }
          ]
        },
        "spurt": {
          "animations": [
            "legion_titan.idle.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "fire": {
          "animations": [
            "legion_titan.fire"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "fire_after": "q.property('titan:action') == 12"
            },
            {
              "reload": "q.property('titan:action') == 4 || ( (q.property('titan:weapon_value') == 0 && q.property('titan:powering_time') == 0) || (q.property('titan:weapon_value') < 2 && q.property('titan:powering_time') == 1) )"
            },
            {
              "power": "q.property('titan:action') == 14"
            },
            {
              "melee": "q.property('titan:action') == 5"
            }
          ]
        },
        "reload": {
          "animations": [
            "legion_titan.reload"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !( (q.property('titan:action') == 3 || q.property('titan:action') == 11) && ((q.property('titan:weapon_value') > 0 && q.property('titan:powering_time') == 0) || (q.property('titan:weapon_value') > 1 && q.property('titan:powering_time') == 1)) )"
            }
          ]
        },
        "melee": {
          "animations": [
            "legion_titan.melee"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ]
        },
        "fire_pre": {
          "animations": [
            "legion_titan.fire_pre"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "fire": "q.property('titan:action') == 3"
            },
            {
              "fire_after": "q.property('titan:action') == 12"
            }
          ]
        },
        "fire_after": {
          "animations": [
            "legion_titan.fire_after"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "reload": "q.property('titan:action') == 4 || ( (q.property('titan:weapon_value') == 0 && q.property('titan:powering_time') == 0) || (q.property('titan:weapon_value') < 2 && q.property('titan:powering_time') == 1) )"
            },
            {
              "fire": "q.property('titan:action') == 3"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5 && !q.is_saddled"
            },
            {
              "power": "q.property('titan:action') == 14"
            },
            {
              "change": "q.property('titan:action') == 16"
            },
            {
              "run": "q.is_sprinting && !q.is_saddled"
            },
            {
              "spurt": "q.out_of_control && !q.is_saddled"
            }
          ]
        },
        "power_pre": {
          "animations": [
            "legion_titan.power_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "power": "q.property('titan:action') != 13"
            }
          ]
        },
        "power": {
          "animations": [
            "legion_titan.power"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "power_after": "q.property('titan:action') != 14"
            }
          ]
        },
        "power_after": {
          "animations": [
            "legion_titan.fire_after"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "fire_after": "q.property('titan:action') != 15"
            }
          ]
        },
        "change": {
          "animations": [
            "legion_titan.change"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') != 16"
            }
          ]
        }
      }
    }
  }
}