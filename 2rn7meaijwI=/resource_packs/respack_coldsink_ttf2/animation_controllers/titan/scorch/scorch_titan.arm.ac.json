{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scorch_titan.arm": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "scorch_titan.idle.arm"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "fire": "q.property('titan:action') == 3"
            },
            {
              "reload": "q.property('titan:action') == 4"
            },
            {
              "melee": "q.property('titan:action') == 5"
            },
            {
              "firewall": "q.property('titan:action') == 11"
            },
            {
              "shield_pre": "q.property('titan:action') == 12"
            },
            {
              "core": "q.property('titan:action') == 15"
            },
            {
              "spurt": "q.out_of_control && q.property('titan:action') == 0"
            },
            {
              "run": "q.is_sprinting && q.property('titan:action') == 0"
            }
          ]
        },
        "run": {
          "animations": [
            "scorch_titan.move.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.is_sprinting || q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "spurt": {
          "animations": [
            "scorch_titan.idle.arm"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "!q.out_of_control || q.property('titan:action') != 0"
            }
          ]
        },
        "fire": {
          "animations": [
            "scorch_titan.fire"
          ],
          "blend_transition": 0,
          "transitions": [
            {
              "reload": "q.property('titan:action') == 4 || (q.property('titan:weapon_value') == 0 && q.property('titan:action') == 0)"
            },
            {
              "default": "q.property('titan:action') != 3"
            }
          ]
        },
        "reload": {
          "animations": [
            "scorch_titan.reload"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "q.property('titan:action') != 4 && !(q.property('titan:action') == 3 && q.property('titan:weapon_value') == 0)"
            }
          ]
        },
        "melee": {
          "animations": [
            "scorch_titan.melee"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 5"
            }
          ]
        },
        "firewall": {
          "animations": [
            "scorch_titan.firewall",
            "scorch_titan.firewall_fix"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 11"
            }
          ]
        },
        "shield_pre": {
          "animations": [
            "scorch_titan.shield_pre"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield": "q.property('titan:action') == 13"
            }
          ]
        },
        "shield": {
          "animations": [
            "scorch_titan.shield",
            "scorch_titan.shield.particle"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "q.property('titan:action') == 0"
            },
            {
              "shield_after": "q.property('titan:action') == 14"
            }
          ]
        },
        "shield_after": {
          "animations": [
            "scorch_titan.shield_after"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 14"
            }
          ]
        },
        "core": {
          "animations": [
            "scorch_titan.core",
            "scorch_titan.core_fix"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "default": "q.property('titan:action') != 15"
            }
          ]
        }
      }
    }
  }
}