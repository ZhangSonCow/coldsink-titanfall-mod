		"animation.pilot_weapon_bullet_count": {
			"loop": true,
			"animation_length": 0.1,
			"bones": {
				"bullet_count_unit_0": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 0 ? 1 : 0"
				},
				"bullet_count_unit_1": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 1 ? 1 : 0"
				},
				"bullet_count_unit_2": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 2 ? 1 : 0"
				},
				"bullet_count_unit_3": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 3 ? 1 : 0"
				},
				"bullet_count_unit_4": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 4 ? 1 : 0"
				},
				"bullet_count_unit_5": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 5 ? 1 : 0"
				},
				"bullet_count_unit_6": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 6 ? 1 : 0"
				},
				"bullet_count_unit_7": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 7 ? 1 : 0"
				},
				"bullet_count_unit_8": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 8 ? 1 : 0"
				},
				"bullet_count_unit_9": {
					"scale": "math.mod(q.property('titan:weapon_value'), 10) == 9 ? 1 : 0"
				},
				"bullet_count_decade_0": {
					"scale": "q.property('titan:weapon_value') > 99 && q.property('titan:weapon_value') < 110 ? 1 : 0"
				},
				"bullet_count_decade_1": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 1 ? 1 : 0"
				},
				"bullet_count_decade_2": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 2 ? 1 : 0"
				},
				"bullet_count_decade_3": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 3 ? 1 : 0"
				},
				"bullet_count_decade_4": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 4 ? 1 : 0"
				},
				"bullet_count_decade_5": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 5 ? 1 : 0"
				},
				"bullet_count_decade_6": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 6 ? 1 : 0"
				},
				"bullet_count_decade_7": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 7 ? 1 : 0"
				},
				"bullet_count_decade_8": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 8 ? 1 : 0"
				},
				"bullet_count_decade_9": {
					"scale": "math.floor(q.property('titan:weapon_value') / 10) == 9 ? 1 : 0"
				},
				"bullet_count_hundred_1": {
					"scale": "q.property('titan:weapon_value') > 99 ? 1 : 0"
				},
				"weapon_bullet_count": {
					"position": ["q.property('titan:weapon_value') < 10 ? 0.1 : (q.property('titan:weapon_value') < 20 ? 0.05 : 0)", 0, 0]
				},
				"bullet_count_bar": {
					"position": [0, 0, "q.property('titan:weapon_value') < 10 ? -0.15 : (q.property('titan:weapon_value') < 20 ? -0.05 : 0)"],
					"scale": [1, 1, "q.property('titan:weapon_value') / 30"]
				}
			}
		},
