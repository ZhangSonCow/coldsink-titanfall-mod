		"animation.health_bar_3": {
			"loop": true,
			"animation_length": 0.1,
			"bones": {
				"health_bar": {
					"rotation": ["-q.camera_rotation(0)", "q.camera_rotation(1)+180-q.body_y_rotation", 0],
					"scale": "query.distance_from_camera > 10 ? (0.12*64*query.camera_distance_range_lerp(0,64)) : 0"
				},
				"damage": {
					"scale": ["1-((q.health/q.max_health-0.25)/0.75)", 1, 1]
				},
				"transition": {
					"scale": ["(v.health_last-q.health)/(q.max_health*0.75)/(1-(((q.health/q.max_health)-0.25)/0.75))", 1, 1]
				}
			},
			"timeline": {
				"0.0": "v.health_last = ( (v.health_last - q.health)*0.8 + q.health ) ;"
			}
		},
