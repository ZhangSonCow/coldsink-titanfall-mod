{
  "format_version": "1.12.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "coldsink:monarch_titan_ai",
      "animations": {
        "health_bar": "animation.health_bar_4",
        "health_bar_danger": "animation.health_bar_4_danger",
        "titan_loading_fire.particle": "animation.titan_loading_fire.particle",
        "titan_look_rotate": "animation.titan_look_rotate",
        "titan_eye_blue": "animation.titan_eye_blue_monarch",
        "titan_eye_red": "animation.titan_eye_red_monarch",
        "titan_weapon_back_yes": "animation.titan_weapon_back_yes",
        "titan_weapon_back_no": "animation.titan_weapon_back_no",
        "c.titan_damage_fire": "controller.animation.titan_damage_fire",
        "damage_fire_1": "animation.monarch_titan.damage_fire_1",
        "damage_fire_2": "animation.monarch_titan.damage_fire_2",
        "damage_fire_3": "animation.monarch_titan.damage_fire_3",
        "damage_fire_4": "animation.monarch_titan.damage_fire_4",

        "titan_ai_terminate": "controller.animation.titan_ai_terminate",
        "terminate_1": "animation.monarch_titan.terminate_1",
        "terminate_2": "animation.monarch_titan.terminate_2",

        "c.monarch_titan_ai.arm": "controller.animation.monarch_titan_ai.arm",
        "c.monarch_titan_ai.leg": "controller.animation.monarch_titan_ai.leg",
        "c.monarch_titan_ai.weapon_back": "controller.animation.monarch_titan_ai.weapon_back",
        "c.monarch_titan_ai.particle": "controller.animation.monarch_titan_ai.particle",

        "monarch_titan.loading": "animation.monarch_titan.loading",
        "monarch_titan.loading_fast": "animation.monarch_titan.loading_fast",
        "monarch_titan.loaded": "animation.monarch_titan.loaded",
        "monarch_titan.standing": "animation.monarch_titan.standing",
        "monarch_titan.idle.leg": "animation.monarch_titan.idle.leg",
        "monarch_titan.walk.leg": "animation.monarch_titan.walk.leg",
        "monarch_titan.move.leg": "animation.monarch_titan.move.leg",
        "monarch_titan.spurt.leg": "animation.monarch_titan.spurt.leg",
        "monarch_titan.idle.arm": "animation.monarch_titan.idle.arm",
        "monarch_titan.fire": "animation.monarch_titan.fire",
        "monarch_titan.fire_arc": "animation.monarch_titan.fire_arc",
        "monarch_titan.fire_final": "animation.monarch_titan.fire_final_ai",
        "monarch_titan.fire_arc_final": "animation.monarch_titan.fire_arc_final_ai",
        "monarch_titan.particle": "animation.monarch_titan.particle",
        "monarch_titan.melee": "animation.monarch_titan.melee",
        "monarch_titan.missile": "animation.monarch_titan.missile",
        "monarch_titan.reflash": "animation.monarch_titan.reflash",
        "monarch_titan.reflash_fast": "animation.monarch_titan.reflash_fast",
        "monarch_titan.energy": "animation.monarch_titan.energy",
        "monarch_titan.energy_after": "animation.monarch_titan.energy_after_ai",
        "monarch_titan.missile_final_powering": "animation.monarch_titan.missile_final_powering",
        "monarch_titan.missile_final": "animation.monarch_titan.missile_final"
      },
      "particle_effects": {
        "titan_loading_around": "titan:titan_loading_around",
        "titan_loading_break": "titan:titan_loading_break",
        "titan_load_shield_blue": "titan:titan_load_shield_blue",
        "titan_load_shield_red": "titan:titan_load_shield_red",
        "titan_eye_blue_1": "titan:titan_eye_blue_1",
        "titan_eye_blue_2": "titan:titan_eye_blue_2",
        "titan_eye_red_1": "titan:titan_eye_red_1",
        "titan_eye_red_2": "titan:titan_eye_red_2",
        "titan_damage_fire_1": "titan:titan_damage_fire_1",
        "titan_damage_fire_2": "titan:titan_damage_fire_2",
        "titan_damage_fire_3": "titan:titan_damage_fire_3",
        "titan_damage_fire_4": "titan:titan_damage_fire_4",
        "titan_spurt_jet": "titan:titan_spurt_jet",

        "monarch_fire": "coldsink:monarch_fire",
        "monarch_fire_arc": "coldsink:monarch_fire_arc",
        "monarch_energy_powering": "titan:monarch_energy_powering",
        "monarch_energy": "titan:monarch_energy",

        "battery_ordinary_jet": "pilot:battery_ordinary_jet"
      },
      "scripts": {
        "pre_animation": [
          "variable.random_choices = math.random(0, 100);"
        ],
        "initialize": [
          "v.health_last = q.max_health;" // 白条过渡
        ],
        "animate": [
          "c.monarch_titan_ai.particle",
          {
            "c.monarch_titan_ai.weapon_back": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "titan_eye_blue": "q.property('titan:team') == 1"
          },
          {
            "titan_eye_red": "q.property('titan:team') == 2"
          },
          {
            "c.titan_damage_fire": "!q.is_riding"
          },
          {
            "titan_look_rotate": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.monarch_titan_ai.arm": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.monarch_titan_ai.leg": "!q.is_riding && q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "health_bar": "q.health > 2500 && q.property('titan:show_health')"
          },
          {
            "health_bar_danger": "q.health <= 2500 && q.property('titan:show_health')"
          },
          {
            "monarch_titan.loading": "q.property('titan:action') == 1"
          },
          {
            "monarch_titan.loading_fast": "q.property('titan:action') == 5"
          },
          {
            "titan_loading_fire.particle": "q.property('titan:action') == 1 || q.property('titan:action') == 5"
          },
          {
            "monarch_titan.loaded": "q.property('titan:action') == 2"
          },
          {
            "monarch_titan.standing": "q.property('titan:action') == 4"
          },
          "titan_ai_terminate"
        ]
      },
      "materials": {
        "default": "entity_alphatest",
        "blend": "entity_alphablend",
        "netease_entity_metallic": "netease_entity_alphablend_metallic",
        "netease_bloom_light_entity": "demo_bloom_entity"
      },
      "textures": {
        "monarch_titan": "textures/entity/titan/monarch/monarch_titan",
        "monarch_titan_light": "textures/entity/titan/monarch/monarch_titan_light",
        "monarch_titan_light_blue": "textures/entity/titan/monarch/monarch_titan_light_blue",
        "monarch_titan_light_red": "textures/entity/titan/monarch/monarch_titan_light_red",
        "monarch_titan_1": "textures/entity/titan/monarch/monarch_titan_1",
        "monarch_titan_2": "textures/entity/titan/monarch/monarch_titan_2",
        "monarch_titan_3": "textures/entity/titan/monarch/monarch_titan_3",
        "monarch_titan_4": "textures/entity/titan/monarch/monarch_titan_4",
        "monarch_titan_5": "textures/entity/titan/monarch/monarch_titan_5",
        "monarch_titan_6": "textures/entity/titan/monarch/monarch_titan_6",
        "monarch_titan_7": "textures/entity/titan/monarch/monarch_titan_7",
        "monarch_titan_8": "textures/entity/titan/monarch/monarch_titan_8",
        "titan_load_shield_blue": "textures/entity/titan/titan_load_shield_blue",
        "titan_load_shield_red": "textures/entity/titan/titan_load_shield_red",
        "health_bar": "textures/entity/titan/health_bar_team",
        "pilot_player": "textures/entity/steve",
        "battery_ordinary": "textures/entity/z_other/battery/battery_ordinary",
        "battery_light": "textures/entity/z_other/battery/battery_light"
      },
      "geometry": {
        "monarch_titan": "geometry.monarch_titan",
        "monarch_titan_light": "geometry.monarch_titan_light",
        "health_bar_4_blue": "geometry.health_bar_4_blue",
        "health_bar_4_danger_blue": "geometry.health_bar_4_danger_blue",
        "health_bar_4_red": "geometry.health_bar_4_red",
        "health_bar_4_danger_red": "geometry.health_bar_4_danger_red",
        "health_bar_6_blue": "geometry.health_bar_6_blue",
        "health_bar_6_danger_blue": "geometry.health_bar_6_danger_blue",
        "health_bar_6_red": "geometry.health_bar_6_red",
        "health_bar_6_danger_red": "geometry.health_bar_6_danger_red",
        "pilot_player": "geometry.pilot_player",
        "pilot_back_battery": "geometry.pilot_back_battery",
        "pilot_back_battery_light": "geometry.pilot_back_battery_light"
      },
      "render_controllers": [
        {
          "controller.render.monarch_titan_ai": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10)"
        },
        {
          "controller.render.monarch_titan_light_blue": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10) && q.property('titan:team') == 1"
        },
        {
          "controller.render.monarch_titan_light_red": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10) && q.property('titan:team') == 2"
        },
        {
          "controller.render.health_bar_4_blue": "q.health > 2500 && q.property('titan:team') == 1 && !q.is_sheared && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_4_danger_blue": "q.health <= 2500 && q.property('titan:team') == 1 && !q.is_sheared && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_4_red": "q.health > 2500 && q.property('titan:team') == 2 && !q.is_sheared && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_4_danger_red": "q.health <= 2500 && q.property('titan:team') == 2 && !q.is_sheared && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_6_blue": "q.health > 2500 && q.property('titan:team') == 1 && q.is_sheared && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_6_danger_blue": "q.health <= 2500 && q.property('titan:team') == 1 && q.is_sheared && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_6_red": "q.health > 2500 && q.property('titan:team') == 2 && q.is_sheared && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_6_danger_red": "q.health <= 2500 && q.property('titan:team') == 2 && q.is_sheared && q.property('titan:show_health')"
        },
        // 处决时渲染铁驭
        {
          "controller.render.pilot_player_ai": "q.property('titan:action') == 10 || q.property('titan:action') == 99"
        },
        // 处决时渲染电池
        {
          "controller.render.pilot_back_battery_1": "q.property('titan:action') == 99"
        },
        {
          "controller.render.pilot_back_battery_1_light": "q.property('titan:action') == 99"
        }
      ],
      "spawn_egg": {
        "texture": "monarch_titan_icon"
      }
    }
  }
}