{
  "format_version": "1.12.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "coldsink:tone_titan",
      "animations": {
        "health_bar": "animation.health_bar_4",
        "health_bar_danger": "animation.health_bar_4_danger",
        "titan_loading_fire.particle": "animation.titan_loading_fire.particle",
        "titan_look_rotate": "animation.titan_look_rotate",
        "titan_eye_blue": "animation.titan_eye_blue_tone",
        "titan_eye_red": "animation.titan_eye_red_tone",
        "titan_weapon_back_yes": "animation.titan_weapon_back_yes",
        "titan_weapon_back_no": "animation.titan_weapon_back_no",
        "c.titan_damage_fire": "controller.animation.titan_damage_fire",
        "damage_fire_1": "animation.tone_titan.damage_fire_1",
        "damage_fire_2": "animation.tone_titan.damage_fire_2",
        "damage_fire_3": "animation.tone_titan.damage_fire_3",
        "damage_fire_4": "animation.tone_titan.damage_fire_4",

        "titan_ai_terminate": "controller.animation.titan_ai_terminate",
        "terminate_1": "animation.tone_titan.terminate_1",
        "terminate_2": "animation.tone_titan.terminate_2",

        "c.tone_titan_ai.arm": "controller.animation.tone_titan_ai.arm",
        "c.tone_titan_ai.leg": "controller.animation.tone_titan_ai.leg",
        "c.tone_titan_ai.weapon_back": "controller.animation.tone_titan_ai.weapon_back",
        "c.tone_titan_ai.particle": "controller.animation.tone_titan_ai.particle",

        "tone_titan.loading": "animation.tone_titan.loading",
        "tone_titan.loading_fast": "animation.tone_titan.loading_fast",
        "tone_titan.loaded": "animation.tone_titan.loaded",
        "tone_titan.standing": "animation.tone_titan.standing",
        "tone_titan.idle.leg": "animation.tone_titan.idle.leg",
        "tone_titan.walk.leg": "animation.tone_titan.walk.leg",
        "tone_titan.move.leg": "animation.tone_titan.move.leg",
        "tone_titan.spurt.leg": "animation.tone_titan.spurt.leg",
        "tone_titan.idle.arm": "animation.tone_titan.idle.arm",
        "tone_titan.fire": "animation.tone_titan.fire_ai",
        "tone_titan.particle": "animation.tone_titan.particle",
        "tone_titan.melee": "animation.tone_titan.melee",
        "tone_titan.missile": "animation.tone_titan.missile",
        "tone_titan.sense": "animation.tone_titan.sense",
        "tone_titan.core": "animation.tone_titan.core"
      },
      "particle_effects": {
        "titan_loading_around": "titan:titan_loading_around",
        "titan_loading_break": "titan:titan_loading_break",
        "titan_load_shield_blue": "titan:titan_load_shield_blue",
        "titan_load_shield_red": "titan:titan_load_shield_red",
        "titan_eye_blue_1": "titan:titan_eye_blue_1",
        "titan_eye_blue_2": "titan:titan_eye_blue_2",
        "titan_eye_red_1": "titan:titan_eye_red_1",
        "titan_eye_red_2": "titan:titan_eye_red_2",
        "titan_damage_fire_1": "titan:titan_damage_fire_1",
        "titan_damage_fire_2": "titan:titan_damage_fire_2",
        "titan_damage_fire_3": "titan:titan_damage_fire_3",
        "titan_damage_fire_4": "titan:titan_damage_fire_4",
        "titan_spurt_jet": "titan:titan_spurt_jet",

        "tone_fire": "coldsink:tone_fire"
      },
      "scripts": {
        "pre_animation": [
          "variable.random_choices = math.random(0, 100);"
        ],
        "initialize": [
          "v.health_last = q.max_health;" // 白条过渡
        ],
        "animate": [
          "c.tone_titan_ai.particle",
          {
            "c.tone_titan_ai.weapon_back": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "titan_eye_blue": "q.property('titan:team') == 1"
          },
          {
            "titan_eye_red": "q.property('titan:team') == 2"
          },
          {
            "c.titan_damage_fire": "!q.is_riding"
          },
          {
            "titan_look_rotate": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.tone_titan_ai.arm": "q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "c.tone_titan_ai.leg": "!q.is_riding && q.property('titan:action') == 0 || (q.property('titan:action') > 10 && q.property('titan:action') < 98)"
          },
          {
            "health_bar": "q.health > 2500 && q.property('titan:show_health')"
          },
          {
            "health_bar_danger": "q.health <= 2500 && q.property('titan:show_health')"
          },
          {
            "tone_titan.loading": "q.property('titan:action') == 1"
          },
          {
            "tone_titan.loading_fast": "q.property('titan:action') == 5"
          },
          {
            "titan_loading_fire.particle": "q.property('titan:action') == 1 || q.property('titan:action') == 5"
          },
          {
            "tone_titan.loaded": "q.property('titan:action') == 2"
          },
          {
            "tone_titan.standing": "q.property('titan:action') == 4"
          },
          "titan_ai_terminate"
        ]
      },
      "materials": {
        "default": "entity_alphatest",
        "blend": "entity_alphablend",
        "netease_entity_metallic": "netease_entity_alphablend_metallic",
        "netease_bloom_light_entity": "demo_bloom_entity"
      },
      "textures": {
        "tone_titan": "textures/entity/titan/tone/tone_titan",
        "tone_titan_light": "textures/entity/titan/tone/tone_titan_light",
        "tone_titan_light_blue": "textures/entity/titan/tone/tone_titan_light_blue",
        "tone_titan_light_red": "textures/entity/titan/tone/tone_titan_light_red",
        "tone_titan_1": "textures/entity/titan/tone/tone_titan_1",
        "tone_titan_2": "textures/entity/titan/tone/tone_titan_2",
        "tone_titan_3": "textures/entity/titan/tone/tone_titan_3",
        "tone_titan_4": "textures/entity/titan/tone/tone_titan_4",
        "tone_titan_5": "textures/entity/titan/tone/tone_titan_5",
        "tone_titan_6": "textures/entity/titan/tone/tone_titan_6",
        "tone_titan_7": "textures/entity/titan/tone/tone_titan_7",
        "tone_titan_8": "textures/entity/titan/tone/tone_titan_8",
        "titan_load_shield_blue": "textures/entity/titan/titan_load_shield_blue",
        "titan_load_shield_red": "textures/entity/titan/titan_load_shield_red",
        "health_bar": "textures/entity/titan/health_bar_team",
        "pilot_player": "textures/entity/steve"
      },
      "geometry": {
        "tone_titan": "geometry.tone_titan",
        "tone_titan_light": "geometry.tone_titan_light",
        "health_bar_blue": "geometry.health_bar_4_blue",
        "health_bar_danger_blue": "geometry.health_bar_4_danger_blue",
        "health_bar_red": "geometry.health_bar_4_red",
        "health_bar_danger_red": "geometry.health_bar_4_danger_red",
        "pilot_player": "geometry.pilot_player"
      },
      "render_controllers": [
        {
          "controller.render.tone_titan_ai": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10)"
        },
        {
          "controller.render.tone_titan_light_blue": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10) && q.property('titan:team') == 1"
        },
        {
          "controller.render.tone_titan_light_red": "!q.is_riding && q.property('titan:action') != 3 && !(q.property('titan:action') > 5 && q.property('titan:action') < 10) && q.property('titan:team') == 2"
        },
        {
          "controller.render.health_bar_blue": "q.health > 2500 && q.property('titan:team') == 1 && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_danger_blue": "q.health <= 2500 && q.property('titan:team') == 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_red": "q.health > 2500 && q.property('titan:team') == 2 && q.property('titan:action') != 1 && q.property('titan:show_health')"
        },
        {
          "controller.render.health_bar_danger_red": "q.health <= 2500 && q.property('titan:team') == 2 && q.property('titan:show_health')"
        },
        // 被处决时渲染铁驭
        {
          "controller.render.pilot_player_ai": "q.property('titan:action') == 10"
        }
      ],
      "spawn_egg": {
        "texture": "tone_titan_icon"
      }
    }
  }
}