{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "titan:titan_damage_fire_3",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/titan/fire"
			}
		},
		"curves": {
			"variable.alpha": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.92, 0.95, 1, 1, 0.96, 0.9, 0.73, 0.45, 0]
			},
			"variable.color": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 1, 0.94, 0.63, 0.32, 0]
			},
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.84, 0.85, 1.55]
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.1, 0],
				"radius": 0.5,
				"direction": ["Math.random(-0.1, 0.1)", "Math.random(0.2, 2)", "Math.random(-0.1, 0.1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.4, 0.6)"
			},
			"minecraft:particle_initial_speed": "math.random(8,12)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 6, 0],
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.4+variable.particle_random_2*0.3)*variable.size", "(0.5+variable.particle_random_2*0.3)*variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 128,
					"flipbook": {
						"base_UV": ["math.floor( (v.particle_age/v.particle_lifetime) * 4 ) * 16", "math.floor( (v.particle_age/v.particle_lifetime) * 4 ) * -16"],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 20,
						"max_frame": 8,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["1*variable.color", "1*variable.color", "1*variable.color", "0.6*variable.alpha"]
			}
		}
	}
}