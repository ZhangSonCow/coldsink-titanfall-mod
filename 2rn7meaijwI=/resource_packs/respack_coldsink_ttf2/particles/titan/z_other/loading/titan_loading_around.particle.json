{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "titan:titan_loading_around",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/titan/fire"
			}
		},
		"curves": {
			"variable.alpha": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.38, 0.88, 1, 1, 0.63, 0]
			}
		},
		"events": {
			"event1": {
				"particle_effect": {
					"effect": "titan:ronin_auto_damage_3_plus",
					"type": "emitter_bound"
				}
			},
			"event2": {
				"particle_effect": {
					"effect": "titan:auto_land_1",
					"type": "emitter_bound"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 300,
				"max_particles": 800
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.2
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["event1", "event2"]
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 6,
				"surface_only": true,
				"direction": ["Math.random(-1, 1)", "Math.random(0, 2)", "Math.random(-1, 1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.1, 0.3)"
			},
			"minecraft:particle_initial_speed": "math.random(1,3)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 2, 0],
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.4+variable.particle_random_2*0.4", "0.4+variable.particle_random_2*0.4"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 128,
					"flipbook": {
						"base_UV": ["v.particle_age/v.particle_lifetime <0.25 ? 0 : (v.particle_age/v.particle_lifetime <0.5 ? 16 : (v.particle_age/v.particle_lifetime <0.75 ? 32 : 48))", 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 16,
						"max_frame": 32,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 20,
				"coefficient_of_restitution": 0.2,
				"collision_radius": 0.05,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, "variable.alpha*0.5"]
			}
		}
	}
}